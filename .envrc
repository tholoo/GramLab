# shellcheck shell=bash
# Nix provides tools; Python dependency sync remains explicit with uv sync --locked.
watch_file flake.nix flake.lock pyproject.toml uv.lock .python-version
watch_file clients/android/toolchain.json nix/android.nix nix/runtime.nix .envrc.local
source_env_if_exists .envrc.local

: "${GRAMLAB_DEV_SHELL:=default}"
case "$GRAMLAB_DEV_SHELL" in
  default|android) ;;
  *) log_error 'GRAMLAB_DEV_SHELL must be default or android'; return 1 ;;
esac

if has nix_direnv_disallow_fallback; then
  nix_direnv_disallow_fallback
fi

use flake ".#$GRAMLAB_DEV_SHELL"
