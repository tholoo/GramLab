#!/usr/bin/env bash
# Keep the selected development closure rooted between command invocations.
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: tools/dev [default|android] [nix develop options]

Enter a pinned development shell and retain its closure in an ignored local profile.
The default shell is selected when no shell name is supplied. Remaining arguments
go directly to nix develop, including --offline and --command.

Examples:
  tools/dev default
  tools/dev android --command python3 --version
HELP
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi

dev_shell=default
if [[ $# -gt 0 && $1 != -* ]]; then
  dev_shell=$1
  shift
fi
case "$dev_shell" in
  default|android) ;;
  *) printf 'Unsupported development shell: %s\n' "$dev_shell" >&2; exit 2 ;;
esac

project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$project_root"
mkdir -p -- .cache/nix/profiles
exec nix develop --profile "$project_root/.cache/nix/profiles/$dev_shell" \
  "$project_root#$dev_shell" "$@"
