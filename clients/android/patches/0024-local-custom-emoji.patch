diff --git a/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabCustomEmoji.java b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabCustomEmoji.java
new file mode 100644
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabCustomEmoji.java
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.messenger.FileLoader;
+import org.telegram.messenger.ImageLocation;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Neutral immutable catalog metadata. Does not populate original Document caches. */
+public final class GramLabCustomEmoji {
+    private GramLabCustomEmoji() {}
+    private static void require(boolean value) {
+        if (!value) throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_CUSTOM_EMOJI");
+    }
+    public static long identifier(Object value) {
+        require(value instanceof String && ((String) value).matches("[1-9][0-9]{0,18}"));
+        try { long id = Long.parseLong((String) value); require(id > 0); return id; }
+        catch (NumberFormatException error) { throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_CUSTOM_EMOJI"); }
+    }
+    public static final class Entry {
+        public final long id, main, thumbnail;
+        public final String fallback;
+        public final boolean free, repaint;
+        public final int duration;
+        private Entry(long id, long main, long thumbnail, String fallback, boolean free, boolean repaint, int duration) {
+            this.id=id; this.main=main; this.thumbnail=thumbnail; this.fallback=fallback;
+            this.free=free; this.repaint=repaint; this.duration=duration;
+        }
+        boolean same(Entry other) {
+            return id==other.id && main==other.main && thumbnail==other.thumbnail && fallback.equals(other.fallback)
+                    && free==other.free && repaint==other.repaint && duration==other.duration;
+        }
+    }
+    static Map<Long, Entry> parse(JSONArray rows, Map<Long, GramLabMedia.Asset> assets) throws JSONException {
+        Map<Long, Entry> result = new LinkedHashMap<>(); long previous=0;
+        for (int i=0; i<rows.length(); i++) {
+            JSONObject r=rows.getJSONObject(i);
+            GramLabBridge.fields(r,"custom_emoji_id","fallback","free","needs_repainting","main_asset_id","thumbnail_asset_id","duration_ms");
+            require(r.length()==7 && r.opt("fallback") instanceof String && r.opt("free") instanceof Boolean
+                    && r.opt("needs_repainting") instanceof Boolean);
+            long id=identifier(r.opt("custom_emoji_id"));
+            long main=GramLabBridge.identifier(r,"main_asset_id"), thumb=GramLabBridge.identifier(r,"thumbnail_asset_id");
+            String fallback=r.getString("fallback"); int duration=GramLabBridge.integer(r,"duration_ms");
+            require(id>previous && !fallback.isEmpty() && fallback.length()<=64);
+            for (int c=0; c<fallback.length(); c++) {
+                char ch=fallback.charAt(c);
+                if (Character.isHighSurrogate(ch)) require(c+1<fallback.length() && Character.isLowSurrogate(fallback.charAt(++c)));
+                else require(!Character.isLowSurrogate(ch));
+            }
+            GramLabMedia.Asset media=assets.get(main), thumbnail=assets.get(thumb);
+            require(media!=null && thumbnail!=null);
+            require(media.width==100 && media.height==100 && (media.mimeType.equals("image/webp") && duration==0
+                    || media.mimeType.equals("video/webm") && duration>0 && duration<=3000));
+            require(thumbnail.mimeType.equals("image/webp") && thumbnail.width<=100 && thumbnail.height<=100 && thumbnail.size<=128*1024);
+            result.put(id,new Entry(id,main,thumb,fallback,r.getBoolean("free"),r.getBoolean("needs_repainting"),duration));
+            previous=id;
+        }
+        return result;
+    }
+    public static TLRPC.TL_document project(Entry entry) {
+        GramLabMedia.Asset main=GramLabMedia.asset(entry.main), thumb=GramLabMedia.asset(entry.thumbnail);
+        require(main!=null && thumb!=null);
+        TLRPC.TL_document result=new TLRPC.TL_document();
+        result.id=entry.id; result.dc_id=-1; result.access_hash=0; result.file_reference=new byte[0];
+        result.date=0; result.mime_type=main.mimeType; result.size=main.size; result.flags=1;
+        TLRPC.TL_photoSize_layer127 size=new TLRPC.TL_photoSize_layer127();
+        size.type="m"; size.w=thumb.width; size.h=thumb.height; size.size=(int)thumb.size;
+        TLRPC.TL_fileLocationToBeDeprecated location=new TLRPC.TL_fileLocationToBeDeprecated();
+        location.volume_id=entry.thumbnail; location.local_id=2; location.dc_id=0;
+        size.location=location; result.thumbs.add(size);
+        TLRPC.TL_documentAttributeCustomEmoji emoji=new TLRPC.TL_documentAttributeCustomEmoji();
+        emoji.alt=entry.fallback; emoji.free=entry.free; emoji.text_color=entry.repaint;
+        emoji.stickerset=new TLRPC.TL_inputStickerSetEmpty(); result.attributes.add(emoji);
+        if (main.mimeType.equals("video/webm")) {
+            TLRPC.TL_documentAttributeVideo dimensions=new TLRPC.TL_documentAttributeVideo();
+            dimensions.w=main.width; dimensions.h=main.height; dimensions.duration=entry.duration/1000.0;
+            dimensions.nosound=true; result.attributes.add(dimensions);
+        } else {
+            TLRPC.TL_documentAttributeImageSize dimensions=new TLRPC.TL_documentAttributeImageSize();
+            dimensions.w=main.width; dimensions.h=main.height; result.attributes.add(dimensions);
+        }
+        TLRPC.TL_documentAttributeFilename filename=new TLRPC.TL_documentAttributeFilename();
+        filename.file_name=main.mimeType.equals("video/webm") ? "emoji.webm" : "emoji.webp";
+        result.attributes.add(filename);
+        return result;
+    }
+    /** Observation of actual deserialized originals, independent of the input descriptor. */
+    public static JSONObject describe(TLRPC.Document document) throws JSONException {
+        JSONArray attrs=new JSONArray();
+        for (TLRPC.DocumentAttribute attr:document.attributes) {
+            JSONObject row=new JSONObject().put("kind",attr.getClass().getSimpleName());
+            if (attr instanceof TLRPC.TL_documentAttributeCustomEmoji) {
+                TLRPC.TL_documentAttributeCustomEmoji emoji=(TLRPC.TL_documentAttributeCustomEmoji)attr;
+                row.put("flags",emoji.flags).put("alt",emoji.alt).put("free",emoji.free).put("text_color",emoji.text_color)
+                    .put("stickerset",emoji.stickerset.getClass().getSimpleName());
+            } else if (attr instanceof TLRPC.TL_documentAttributeVideo) {
+                row.put("flags",attr.flags).put("width",attr.w).put("height",attr.h).put("duration",attr.duration)
+                    .put("nosound",attr.nosound).put("round_message",attr.round_message).put("supports_streaming",attr.supports_streaming);
+            } else if (attr instanceof TLRPC.TL_documentAttributeImageSize) row.put("width",attr.w).put("height",attr.h);
+            else if (attr instanceof TLRPC.TL_documentAttributeFilename) row.put("file_name",attr.file_name);
+            attrs.put(row);
+        }
+        JSONArray thumbs=new JSONArray();
+        for (TLRPC.PhotoSize size:document.thumbs) {
+            ImageLocation image=ImageLocation.getForDocument(size,document);
+            thumbs.put(new JSONObject().put("kind",size.getClass().getSimpleName()).put("type",size.type)
+                .put("width",size.w).put("height",size.h).put("size",size.size)
+                .put("volume_id",size.location.volume_id).put("local_id",size.location.local_id)
+                .put("location_dc_id",size.location.dc_id).put("image_dc_id",image.dc_id)
+                .put("key",image.getKey(document,null,false)).put("filename",FileLoader.getAttachFileName(size)));
+        }
+        return new JSONObject().put("id",Long.toString(document.id)).put("dc_id",document.dc_id)
+            .put("access_hash",document.access_hash).put("file_reference_bytes",document.file_reference.length)
+            .put("date",document.date).put("mime_type",document.mime_type).put("size",document.size)
+            .put("flags",document.flags).put("thumbs",thumbs).put("video_thumbs",document.video_thumbs.size())
+            .put("attributes",attrs).put("key",ImageLocation.getForDocument(document).getKey(document,null,false))
+            .put("filename",FileLoader.getAttachFileName(document));
+    }
+}
