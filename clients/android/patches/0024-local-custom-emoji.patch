+    public static org.telegram.tgnet.Vector customEmojiDocuments(JSONObject configuration, Snapshot state,
+            java.util.List<Long> requested) throws Exception {
+        boundState(configuration, state);
+        require(integer(configuration, "bridge_version") == 4 && requested != null
+                && !requested.isEmpty() && requested.size() <= 200);
+        java.util.TreeSet<Long> ids = new java.util.TreeSet<>();
+        for (Long id : requested) { require(id != null && id > 0); ids.add(id); }
+        JSONArray encoded = new JSONArray(); for (long id : ids) encoded.put(Long.toString(id));
+        JSONObject body = exchange(configuration, "/v4/custom-emoji-documents",
+                new JSONObject().put("custom_emoji_ids", encoded));
+        fields(body, "schema", "world_id", "user_id", "custom_emoji", "assets");
+        require(body.length() == 5);
+        try (GramLabMedia.Scope scope = GramLabMedia.scope(configuration,
+                body.getJSONArray("assets"), body.getJSONArray("custom_emoji"))) {
+            require(scope.incomingDocuments.keySet().equals(ids));
+            java.util.Set<Long> assets = new HashSet<>();
+            org.telegram.tgnet.Vector result = new org.telegram.tgnet.Vector();
+            for (GramLabCustomEmoji.Entry entry : scope.incomingDocuments.values()) {
+                assets.add(entry.main); assets.add(entry.thumbnail);
+                result.objects.add(GramLabCustomEmoji.project(entry));
+            }
+            require(scope.incomingAssets.keySet().equals(assets));
+            scope.commit();
+            return result;
+        }
+    }
+
