+    private static long peerForChat(Snapshot state, long chat) {
+        for (Map.Entry<Long, Long> entry : state.chatIdsByPeer.entrySet()) {
+            if (entry.getValue() == chat) return entry.getKey();
+        }
+        throw new IllegalArgumentException("GRAMLAB_BRIDGE_UNKNOWN_CHAT");
+    }
