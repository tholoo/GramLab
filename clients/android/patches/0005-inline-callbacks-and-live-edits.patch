+    public static EventBatch events(JSONObject configuration, Snapshot state, long after) throws Exception {
+        require(after >= 0);
+        JSONObject body = exchange(configuration, "/v1/events?after=" + after, null);
+        fields(body, "schema", "world_id", "user_id", "cursor", "head", "events");
+        long cursor = nonnegative(body, "cursor");
+        require(cursor >= after && cursor <= nonnegative(body, "head"));
+        int now = state.now;
+        ArrayList<TLRPC.Update> updates = new ArrayList<>();
+        JSONArray events = body.getJSONArray("events");
+        long previous = after;
+        for (int i = 0; i < events.length(); i++) {
+            JSONObject event = events.getJSONObject(i);
+            fields(event, "sequence", "type", "data");
+            long sequence = identifier(event, "sequence");
+            require(sequence > previous && sequence <= cursor);
+            previous = sequence;
+            String type = event.getString("type");
+            JSONObject data = event.getJSONObject("data");
+            if ("message.created".equals(type) || "message.edited".equals(type)) {
+                long peer = peerForChat(state, identifier(data, "chat_id"));
+                TLRPC.TL_message message = message(data, state.persona, peer);
+                if ("message.created".equals(type)) {
+                    TL_update.TL_updateNewMessage update = new TL_update.TL_updateNewMessage();
+                    update.message = message;
+                    updates.add(update);
+                } else {
+                    TL_update.TL_updateEditMessage update = new TL_update.TL_updateEditMessage();
+                    update.message = message;
+                    updates.add(update);
+                }
+            } else if ("clock.advanced".equals(type)) {
+                fields(data, "now");
+                now = Math.max(now, integer(data, "now"));
+            } else if ("callback.created".equals(type)) {
+                fields(data, "id", "user_id", "chat_id", "message", "data", "chat_instance");
+                require(identifier(data, "user_id") == state.persona);
+                peerForChat(state, identifier(data, "chat_id"));
+            } else if ("callback.answered".equals(type)) {
+                fields(data, "id", "user_id", "answer");
+                require(identifier(data, "user_id") == state.persona);
+                answer(data.getJSONObject("answer"));
+            } else {
+                // New participants require snapshot reconciliation, which is a separate capability.
+                throw new UnsupportedOperationException("GRAMLAB_UNSUPPORTED_CLIENT_EVENT");
+            }
+        }
+        // These are semantic controller inputs, not fabricated MTProto packets or pts values.
+        return new EventBatch(cursor, now, updates);
+    }
+
+    private static TLRPC.TL_messages_botCallbackAnswer answer(JSONObject data) throws JSONException {
+        fields(data, "text", "show_alert", "cache_time");
+        require(data.get("text") instanceof String && data.get("show_alert") instanceof Boolean);
+        require(integer(data, "cache_time") == 0);
+        String text = data.getString("text");
+        require(text.codePointCount(0, text.length()) <= 200);
+        TLRPC.TL_messages_botCallbackAnswer result = new TLRPC.TL_messages_botCallbackAnswer();
+        result.alert = data.getBoolean("show_alert");
+        if (!text.isEmpty()) { result.message = text; result.flags |= 1; }
+        if (result.alert) result.flags |= 1 << 1;
+        result.cache_time = 0;
+        return result;
+    }
+
+    public static TLRPC.TL_messages_botCallbackAnswer callback(JSONObject configuration, Snapshot state,
+            TLRPC.TL_messages_getBotCallbackAnswer query) throws Exception {
+        if (query.peer == null || !state.chatIdsByPeer.containsKey(query.peer.user_id)
+                || query.game || query.password != null || (query.flags & ~1) != 0) {
+            throw new UnsupportedOperationException();
+        }
+        require(query.msg_id > 0 && query.data != null && query.data.length > 0 && query.data.length <= 64);
+        String data = new String(query.data, StandardCharsets.UTF_8);
+        require(Arrays.equals(query.data, data.getBytes(StandardCharsets.UTF_8)));
+        long chat = state.chatIdsByPeer.get(query.peer.user_id);
+        JSONObject parameters = new JSONObject().put("request_id", UUID.randomUUID().toString())
+                .put("chat_id", chat).put("message_id", query.msg_id).put("data", data);
+        JSONObject body = exchange(configuration, "/v1/callbacks", parameters);
+        long deadline = SystemClock.elapsedRealtime() + 15000;
+        String id = null;
+        while (true) {
+            fields(body, "schema", "world_id", "user_id", "callback");
+            JSONObject record = body.getJSONObject("callback");
+            fields(record, "id", "user_id", "chat_id", "message", "data", "chat_instance", "answer");
+            String receivedId = record.getString("id");
+            require(receivedId.matches("[A-Za-z0-9_-]{1,128}") && (id == null || id.equals(receivedId)));
+            id = receivedId;
+            require(identifier(record, "user_id") == state.persona && identifier(record, "chat_id") == chat
+                    && identifier(record.getJSONObject("message"), "id") == query.msg_id
+                    && data.equals(record.getString("data")));
+            if (!record.isNull("answer")) return answer(record.getJSONObject("answer"));
+            if (SystemClock.elapsedRealtime() >= deadline) {
+                throw new IllegalStateException("GRAMLAB_CALLBACK_ANSWER_TIMEOUT");
+            }
+            Thread.sleep(100);
+            body = exchange(configuration, "/v1/callbacks/" + id, null);
+        }
+    }
