+    public static final class EventBatch {
+        public final long cursor;
+        public final int now;
+        public final ArrayList<TLRPC.Update> updates;
+        private EventBatch(long cursor, int now, ArrayList<TLRPC.Update> updates) {
+            this.cursor = cursor; this.now = now; this.updates = updates;
+        }
+    }
