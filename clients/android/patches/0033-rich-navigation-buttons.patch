+    private static String generatedText(TL_iv.RichText value) throws Exception {
+        Object text = richText(value);
+        if (!(text instanceof String)) {
+            throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_GENERATED_TEXT");
+        }
+        return (String) text;
+    }
+
+    private static String withoutSigil(String text) throws Exception {
+        if (text.length() < 2) {
+            throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_GENERATED_TEXT");
+        }
+        return text.substring(1);
+    }
+
+    private static String bankCardNumber(String text) throws Exception {
+        StringBuilder digits = new StringBuilder();
+        for (int index = 0; index < text.length(); index++) {
+            char value = text.charAt(index);
+            if (value >= '0' && value <= '9') digits.append(value);
+        }
+        if (digits.length() == 0) {
+            throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_GENERATED_TEXT");
+        }
+        return digits.toString();
+    }
