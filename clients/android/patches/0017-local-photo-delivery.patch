diff --git a/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabMedia.java b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabMedia.java
new file mode 100644
index 0000000..3570686
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabMedia.java
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.File;
+import java.io.FileWriter;
+import org.telegram.messenger.ApplicationLoader;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** World-bound synthetic media descriptors; identifiers are never capabilities. */
+public final class GramLabMedia {
+    public static final class Asset {
+        public final long id;
+        public final String mimeType;
+        public final long size;
+        public final String sha256;
+        public final int width;
+        public final int height;
+        private Asset(long id, String mimeType, long size, String sha256, int width, int height) {
+            this.id = id; this.mimeType = mimeType; this.size = size; this.sha256 = sha256;
+            this.width = width; this.height = height;
+        }
+    }
+
+    private static String worldId;
+    private static JSONObject configuration;
+    private static final Map<Long, Asset> assets = new LinkedHashMap<>();
+
+    private GramLabMedia() {}
+
+    public static synchronized void beginWorld(JSONObject config, String world) throws JSONException {
+        if (!world.equals(worldId)) {
+            assets.clear();
+            worldId = world;
+        }
+        configuration = new JSONObject(config.toString());
+    }
+
+    public static synchronized void install(JSONArray records) throws JSONException {
+        long previous = 0;
+        for (int i = 0; i < records.length(); i++) {
+            JSONObject record = records.getJSONObject(i);
+            GramLabBridge.fields(record, "asset_id", "mime_type", "file_size", "sha256", "width", "height");
+            long id = GramLabBridge.identifier(record, "asset_id");
+            long size = GramLabBridge.identifier(record, "file_size");
+            int width = GramLabBridge.integer(record, "width");
+            int height = GramLabBridge.integer(record, "height");
+            String mime = record.getString("mime_type");
+            String digest = record.getString("sha256");
+            if (id <= previous || size > 10_000_000 || width <= 0 || height <= 0
+                    || width + (long) height > 10_000 || width * (long) height > 25_000_000
+                    || Math.max(width, height) > 20L * Math.min(width, height)
+                    || !(mime.equals("image/png") || mime.equals("image/jpeg"))
+                    || !digest.matches("[0-9a-f]{64}")) throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_ASSET");
+            previous = id;
+            Asset incoming = new Asset(id, mime, size, digest, width, height);
+            Asset old = assets.get(id);
+            if (old != null && (!old.mimeType.equals(mime) || old.size != size || !old.sha256.equals(digest)
+                    || old.width != width || old.height != height)) throw new IllegalArgumentException("GRAMLAB_BRIDGE_ASSET_CHANGED");
+            assets.put(id, incoming);
+        }
+    }
+
+    public static synchronized Asset asset(long id) { return assets.get(id); }
+    public static synchronized JSONObject configuration() throws JSONException {
+        if (configuration == null) throw new IllegalStateException("GRAMLAB_BRIDGE_NOT_CONNECTED");
+        return new JSONObject(configuration.toString());
+    }
+
+    public static TLRPC.TL_photo photo(long assetId, int date) {
+        Asset asset = asset(assetId);
+        if (asset == null) throw new IllegalArgumentException("GRAMLAB_BRIDGE_UNKNOWN_ASSET");
+        TLRPC.TL_fileLocationToBeDeprecated location = new TLRPC.TL_fileLocationToBeDeprecated();
+        location.dc_id = 0; location.volume_id = asset.id; location.local_id = 1; location.secret = 0;
+        TLRPC.TL_photoSize size = new TLRPC.TL_photoSize();
+        size.type = "x"; size.location = location; size.w = asset.width; size.h = asset.height; size.size = (int) asset.size;
+        TLRPC.TL_photo photo = new TLRPC.TL_photo();
+        photo.id = asset.id; photo.access_hash = 0; photo.file_reference = new byte[0]; photo.date = date;
+        photo.dc_id = 0; photo.sizes.add(size);
+        return photo;
+    }
+
+    public static boolean matches(File file, Asset asset) {
+        try (java.io.FileInputStream input = new java.io.FileInputStream(file)) {
+            java.security.MessageDigest digest = java.security.MessageDigest.getInstance("SHA-256");
+            byte[] buffer = new byte[8192]; int count; long size = 0;
+            while ((count = input.read(buffer)) != -1) { size += count; digest.update(buffer, 0, count); }
+            return size == asset.size && hex(digest.digest()).equals(asset.sha256);
+        } catch (Exception error) { return false; }
+    }
+
+    public static String hex(byte[] bytes) {
+        StringBuilder result = new StringBuilder(bytes.length * 2);
+        for (byte value : bytes) result.append(String.format(java.util.Locale.ROOT, "%02x", value & 255));
+        return result.toString();
+    }
+
+    public static synchronized void trace(String event, long assetId, String fileName, long size, boolean digestOk) {
+        try {
+            File directory = new File(ApplicationLoader.applicationContext.getFilesDir(), "gramlab");
+            directory.mkdirs();
+            JSONObject row = new JSONObject().put("event", event).put("asset_id", assetId)
+                    .put("cache_file", fileName).put("file_size", size).put("digest_ok", digestOk);
+            try (FileWriter output = new FileWriter(new File(directory, "trace.jsonl"), true)) {
+                output.write(row.toString()); output.write("\n");
+            }
+        } catch (Exception ignored) {}
+    }
+
+    public static JSONObject describePhoto(TLRPC.Photo value) throws JSONException {
+        if (!(value instanceof TLRPC.TL_photo) || value.id <= 0 || value.dc_id != 0
+                || value.access_hash != 0 || value.file_reference == null || value.file_reference.length != 0
+                || value.sizes.size() != 1) throw new IllegalArgumentException("GRAMLAB_INVALID_SYNTHETIC_PHOTO");
+        TLRPC.PhotoSize size = value.sizes.get(0);
+        if (!(size instanceof TLRPC.TL_photoSize) || size.location == null || size.location.dc_id != 0
+                || size.location.volume_id != value.id || size.location.local_id != 1)
+            throw new IllegalArgumentException("GRAMLAB_INVALID_SYNTHETIC_PHOTO");
+        return new JSONObject().put("asset_id", value.id).put("dc_id", value.dc_id)
+                .put("access_hash", value.access_hash).put("file_reference_bytes", value.file_reference.length)
+                .put("size_type", size.type).put("volume_id", size.location.volume_id)
+                .put("local_id", size.location.local_id).put("width", size.w).put("height", size.h)
+                .put("file_size", size.size);
+    }
+
+    public static boolean isSynthetic(org.telegram.messenger.ImageLocation location) {
+        return location != null && location.location != null && location.dc_id == 0
+                && location.location.dc_id == 0 && location.location.volume_id > 0 && location.location.local_id == 1;
+    }
+}
