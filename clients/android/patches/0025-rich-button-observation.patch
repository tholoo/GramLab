+    private static void reload() throws Exception {
+        if(directory==null||activation==null)return;
+        File disarmFile=new File(directory,"rich-button-disarm.json");
+        if(disarmFile.isFile()) {
+            JSONObject disarm=strict(disarmFile); exact(disarm,"schema","nonce","client_nonce","operation_id");
+            if(positive(disarm,"schema")!=1||!activation.getString("nonce").equals(token(disarm,"nonce"))
+                    ||!clientNonce.equals(token(disarm,"client_nonce")))throw invalid();
+            if(arm!=null&&token(arm,"operation_id").equals(token(disarm,"operation_id"))){disarmedOperation=token(disarm,"operation_id");arm=null;armEncoded=null;}
+        }
+        File armFile=new File(directory,"rich-button-arm.json");
+        if(!armFile.isFile())return;
+        JSONObject candidate=strict(armFile); exact(candidate,"schema","nonce","client_nonce","operation_id","world_id","user_id","chat_id","message_id","revision","path","observation_generation");
+        if(positive(candidate,"schema")!=1||!activation.getString("nonce").equals(token(candidate,"nonce"))
+                ||!clientNonce.equals(token(candidate,"client_nonce"))||!activation.getString("world_id").equals(candidate.opt("world_id"))
+                ||positive(candidate,"user_id")!=positive(activation,"user_id")||positive(candidate,"chat_id")!=positive(activation,"chat_id")
+                ||positive(candidate,"message_id")!=positive(activation,"message_id")||positive(candidate,"revision")!=positive(activation,"revision")
+                ||!(candidate.opt("path") instanceof JSONArray)||nonnegative(candidate,"observation_generation")>generation)throw invalid();
+        String operation=token(candidate,"operation_id"); if(operation.equals(disarmedOperation))return; String encoded=candidate.toString();
+        if(arm!=null&&!encoded.equals(armEncoded))throw invalid();
+        if(arm==null){arm=candidate;armEncoded=encoded; Binding binding=find(candidate.getJSONArray("path")); if(binding==null)throw invalid(); effect(binding,"armed",null,false,false,null);}
+    }
