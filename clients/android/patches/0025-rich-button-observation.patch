+    public static synchronized void install(Context context, GramLabBridge.Snapshot snapshot) throws Exception {
+        directory = new File(context.getFilesDir(), "gramlab");
+        File observe=new File(directory,"rich-button-observe.json");
+        if(!observe.exists())return;
+        activation=strict(observe); exact(activation,"schema","nonce","world_id","user_id","chat_id","message_id","revision");
+        if(positive(activation,"schema")!=1||!token(activation,"nonce").equals(activation.getString("nonce"))
+                ||!snapshot.worldId.equals(activation.opt("world_id"))||positive(activation,"user_id")!=snapshot.persona
+                ||!snapshot.chatIdsByPeer.containsValue(positive(activation,"chat_id")))throw invalid();
+        positive(activation,"message_id"); positive(activation,"revision");
+    }
+
+    public static synchronized void poll() { try { reload(); } catch (Exception ignored) { } }
