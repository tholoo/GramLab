+    public static void beginDecode(JSONObject rich, long revision) {
+        ArrayDeque<Binding> queue = new ArrayDeque<>();
+        collect(rich, new JSONArray(), queue, revision);
+        java.util.ArrayList<Binding> group=new java.util.ArrayList<>(queue); for(Binding binding:group)binding.group=group; groups.add(group);
+        decoding.set(queue);
+    }
+
+    private static void collect(Object value, JSONArray path, ArrayDeque<Binding> queue, long revision) {
+        if (value instanceof JSONObject) {
+            JSONObject object = (JSONObject) value;
+            if ("button".equals(object.optString("type")) && object.opt("button") instanceof JSONObject)
+                queue.add(new Binding(append(path, "button"), object.optJSONObject("button"), revision));
+            if ("buttons".equals(object.optString("type")) && object.opt("buttons") instanceof JSONArray) {
+                JSONArray values = object.optJSONArray("buttons");
+                for (int i = 0; i < values.length(); i++) queue.add(new Binding(append(append(path, "buttons"), i), values.optJSONObject(i), revision));
+            }
+            Iterator<String> keys = object.keys();
+            while (keys.hasNext()) { String key=keys.next(); if (!"button".equals(key) && !"buttons".equals(key)) collect(object.opt(key), append(path,key), queue, revision); }
+        } else if (value instanceof JSONArray) {
+            JSONArray array=(JSONArray)value; for(int i=0;i<array.length();i++) collect(array.opt(i),append(path,i),queue,revision);
+        }
+    }
+    private static JSONArray append(JSONArray base,Object part) { JSONArray out=new JSONArray(); for(int i=0;i<base.length();i++) out.put(base.opt(i)); out.put(part); return out; }
+    public static void bindDecoded(Object object) { ArrayDeque<Binding> q=decoding.get(); if(q!=null&&!q.isEmpty()) bindings.put(object,q.remove()); }
+    public static void transfer(Object from,Object to) { Binding b=bindings.get(from); if(b!=null) bindings.put(to,b); }
+    public static void endDecode() { decoding.remove(); }
+
+    public static synchronized void bind(Object object, JSONArray path, JSONObject button) {
+        bindings.put(object, new Binding(path, button, 0));
+    }
+
+    public static synchronized void drawn(MessageObject message, ChatMessageCell cell, Object object, String label, Canvas canvas, RectF local) {
+        Binding binding = bindings.get(object);
+        if (activation == null || binding == null || message == null || cell == null) return;
+        try {
+            if (activation.optInt("schema") != 1 || activation.optLong("message_id") != message.getId() || positive(activation,"revision") != binding.revision) return;
+            RectF measured = new RectF(local); canvas.getMatrix().mapRect(measured); int[] location=new int[2]; cell.getLocationOnScreen(location);
+            binding.local=new RectF(measured); binding.screen=new RectF(measured); binding.screen.offset(location[0],location[1]); binding.origin=new JSONArray().put(measured.left-local.left).put(measured.top-local.top); binding.label=label; binding.messageId=message.getId();
+            JSONArray targets=new JSONArray(); for(Binding candidate:binding.group){JSONObject target=new JSONObject().put("path",candidate.path).put("button",candidate.button)
+                    .put("label",candidate.label==null?"":candidate.label).put("available",candidate.local!=null).put("reason",candidate.local==null?"message_not_drawn":JSONObject.NULL);
+                if(candidate.local!=null)target.put("local_bounds",rect(candidate.local)).put("origin",candidate.origin).put("screen_bounds",rect(candidate.screen)); targets.put(target);}
+            JSONObject result = copy(activation).put("client_nonce", clientNonce).put("pid", android.os.Process.myPid())
+                    .put("generation", ++generation).put("drawn_uptime_ms", SystemClock.uptimeMillis())
+                    .put("available", true).put("reason", JSONObject.NULL).put("targets", targets);
+            write("rich-button-observation.json", result);
+        } catch (Exception ignored) { }
+    }
+
+    public static synchronized void down(Object object, boolean disabled) {
+        try { reload(); } catch (Exception failure) { return; } Binding binding = bindings.get(object);
+        if (binding == null || arm == null || !binding.path.toString().equals(arm.optJSONArray("path").toString())) return;
+        effect(binding, disabled ? "complete" : "consumed", disabled ? "disabled_suppressed" : null, true, false, null);
+    }
+
+    public static synchronized void action(Object object, String action) {
+        Binding binding = bindings.get(object); if (binding != null) { dispatched = binding; effect(binding, "consumed", action, true, true, null); }
+    }
+
+    public static synchronized void copied(Object object, CharSequence before, CharSequence after) {
+        Binding binding = bindings.get(object); if (binding != null) try { effect(binding, "complete", "copy", true, true,
+                new JSONObject().put("before", before == null ? JSONObject.NULL : before).put("after", after == null ? JSONObject.NULL : after)); } catch(Exception ignored) { }
+    }
+
+
+    public static synchronized void nativeRequest(Object query, int token) {
+        if (dispatched == null || arm == null) return;
+        JSONObject chain; try { chain = new JSONObject().put("native_request_token", token).put("request_id", JSONObject.NULL)
+                .put("callback_id", JSONObject.NULL).put("message_revision", JSONObject.NULL); } catch(Exception failure) { return; }
+        requests.put(query, chain);
+        effect(dispatched, "consumed", "callback", true, true, null);
+    }
+    public static synchronized void httpRequest(Object query, String requestId) { JSONObject c=requests.get(query); if(c!=null)try{c.put("request_id",requestId);}catch(Exception ignored){} }
+    public static synchronized void callbackResponse(Object query, String callbackId, long revision) {
+        JSONObject c=requests.remove(query); if(c==null||dispatched==null)return;
+        try { c.put("callback_id",callbackId).put("message_revision",revision); JSONObject result=read("rich-button-effect.json"); if(result!=null){result.put("requests",new JSONArray().put(c)).put("state","complete");write("rich-button-effect.json",result);} } catch(Exception ignored){}
+    }
+
+    public static CharSequence clipboard(Context context) {
+        ClipboardManager manager = (ClipboardManager) context.getSystemService(Context.CLIPBOARD_SERVICE);
+        ClipData clip = manager.getPrimaryClip(); return clip == null || clip.getItemCount() == 0 ? null : clip.getItemAt(0).coerceToText(context);
+    }
+
+    private static void effect(Binding binding, String state, String action, boolean down, boolean up, JSONObject clipboard) {
+        try {
+            if (arm == null) return;
+            JSONObject result = new JSONObject().put("schema",1).put("nonce",arm.get("nonce")).put("client_nonce",clientNonce).put("operation_id",arm.get("operation_id"))
+                    .put("world_id",arm.get("world_id")).put("user_id",arm.get("user_id")).put("chat_id",arm.get("chat_id")).put("message_id",arm.get("message_id"))
+                    .put("revision",arm.get("revision")).put("path",arm.get("path")).put("generation", ++generation).put("uptime_ms", SystemClock.uptimeMillis())
+                    .put("state", state).put("reason", JSONObject.NULL)
+                    .put("touch", new JSONObject().put("down_uptime_ms", down ? SystemClock.uptimeMillis() : JSONObject.NULL)
+                            .put("up_uptime_ms", up ? SystemClock.uptimeMillis() : JSONObject.NULL).put("path", binding.path))
+                    .put("action", action == null ? JSONObject.NULL : action).put("requests", new JSONArray())
+                    .put("clipboard", clipboard == null ? JSONObject.NULL : clipboard);
+            write("rich-button-effect.json", result);
+        } catch (Exception ignored) { }
+    }
+
+    private static JSONArray rect(RectF r) { return new JSONArray().put(r.left).put(r.top).put(r.right).put(r.bottom); }
+    private static JSONObject copy(JSONObject value) throws Exception { return new JSONObject(value.toString()); }
+    private static void write(String name, JSONObject value) throws Exception {
+        File temporary = new File(directory, name + ".tmp"); Files.write(temporary.toPath(), value.toString().getBytes(StandardCharsets.UTF_8));
+        Files.move(temporary.toPath(), new File(directory, name).toPath(), StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+    }
