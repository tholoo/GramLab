+    private static final class DuplicateScanner {
+        final String text; int offset;
+        DuplicateScanner(String text) { this.text = text; }
+        void scan() { value(); whitespace(); if (offset != text.length()) throw invalid(); }
+        void whitespace() { while (offset < text.length() && Character.isWhitespace(text.charAt(offset))) offset++; }
+        void value() {
+            whitespace(); if (offset >= text.length()) throw invalid(); char c=text.charAt(offset);
+            if (c=='{') object(); else if(c=='[') array(); else if(c=='\"') string(); else primitive();
+        }
+        String string() {
+            whitespace(); int start=offset; if(offset>=text.length()||text.charAt(offset++)!='\"') throw invalid();
+            while(offset<text.length()){char c=text.charAt(offset++); if(c=='\"'){try{return (String)new JSONTokener(text.substring(start,offset)).nextValue();}catch(Exception failure){throw invalid();}} if(c=='\\'){if(offset>=text.length())throw invalid();char e=text.charAt(offset++);if(e=='u'){if(offset+4>text.length())throw invalid();offset+=4;}}} throw invalid();
+        }
+        void object(){offset++; java.util.HashSet<String> keys=new java.util.HashSet<>(); whitespace(); if(offset<text.length()&&text.charAt(offset)=='}'){offset++;return;} while(true){String key=string(); if(!keys.add(key))throw invalid(); whitespace();if(offset>=text.length()||text.charAt(offset++)!=':')throw invalid();value();whitespace();if(offset>=text.length())throw invalid();char c=text.charAt(offset++);if(c=='}')return;if(c!=',')throw invalid();}}
+        void array(){offset++;whitespace();if(offset<text.length()&&text.charAt(offset)==']'){offset++;return;}while(true){value();whitespace();if(offset>=text.length())throw invalid();char c=text.charAt(offset++);if(c==']')return;if(c!=',')throw invalid();}}
+        void primitive(){while(offset<text.length()&&",]} \t\r\n".indexOf(text.charAt(offset))<0)offset++;}
+    }
+    private static IllegalArgumentException invalid() { return new IllegalArgumentException("invalid_rich_button_observation"); }
+    private static JSONObject strict(File file) {
+        try {
+            if (!file.isFile() || file.length() > 1024 * 1024) throw invalid();
+            byte[] bytes=Files.readAllBytes(file.toPath()); String encoded=new String(bytes,StandardCharsets.UTF_8);
+            if(!java.util.Arrays.equals(bytes,encoded.getBytes(StandardCharsets.UTF_8)))throw invalid();
+            new DuplicateScanner(encoded).scan(); JSONTokener parser=new JSONTokener(encoded); Object value=parser.nextValue();
+            if(!(value instanceof JSONObject)||parser.nextClean()!=0)throw invalid(); return (JSONObject)value;
+        } catch (IllegalArgumentException failure) { throw failure; } catch(Exception failure){throw invalid();}
+    }
+    private static void exact(JSONObject value, String... names) {
+        java.util.HashSet<String> remaining=new java.util.HashSet<>(java.util.Arrays.asList(names)); Iterator<String> keys=value.keys();
+        while(keys.hasNext())if(!remaining.remove(keys.next()))throw invalid(); if(!remaining.isEmpty())throw invalid();
