+    private static Object richText(TL_iv.RichText value) throws Exception {
+        if (value instanceof TL_iv.textEmpty) return "";
+        if (value instanceof TL_iv.textPlain) return ((TL_iv.textPlain) value).text;
+        if (value instanceof TL_iv.textConcat) {
+            JSONArray result = new JSONArray();
+            for (TL_iv.RichText item : value.texts) result.put(richText(item));
+            return result;
+        }
+        String type;
+        if (value instanceof TL_iv.textBold) type = "bold";
+        else if (value instanceof TL_iv.textItalic) type = "italic";
+        else if (value instanceof TL_iv.textUnderline) type = "underline";
+        else if (value instanceof TL_iv.textStrike) type = "strikethrough";
+        else if (value instanceof TL_iv.textSpoiler) type = "spoiler";
+        else if (value instanceof TL_iv.textSubscript) type = "subscript";
+        else if (value instanceof TL_iv.textSuperscript) type = "superscript";
+        else if (value instanceof TL_iv.textMarked) type = "marked";
+        else if (value instanceof TL_iv.textFixed) type = "code";
+        else throw new IllegalStateException("GRAMLAB_PROBE_UNKNOWN_RICH_TEXT");
+        return new JSONObject().put("type", type).put("text", richText(value.text));
+    }
+
+    private static void optionalRichText(JSONObject result, String key, TL_iv.RichText value) throws Exception {
+        if (value != null && !(value instanceof TL_iv.textEmpty)
+                && !(value instanceof TL_iv.textPlain && ((TL_iv.textPlain) value).text.isEmpty())) {
+            result.put(key, richText(value));
+        }
+    }
+
+    private static JSONArray richBlocks(java.util.List<TL_iv.PageBlock> blocks) throws Exception {
+        JSONArray result = new JSONArray();
+        for (TL_iv.PageBlock block : blocks) result.put(richBlock(block));
+        return result;
+    }
+
+    private static JSONObject richBlock(TL_iv.PageBlock block) throws Exception {
+        JSONObject result = new JSONObject();
+        int heading = block instanceof TL_iv.pageBlockHeading1 ? 1
+                : block instanceof TL_iv.pageBlockHeading2 ? 2
+                : block instanceof TL_iv.pageBlockHeading3 ? 3
+                : block instanceof TL_iv.pageBlockHeading4 ? 4
+                : block instanceof TL_iv.pageBlockHeading5 ? 5
+                : block instanceof TL_iv.pageBlockHeading6 ? 6 : 0;
+        if (heading != 0) {
+            return result.put("type", "heading").put("size", heading).put("text", richText(block.text));
+        }
+        if (block instanceof TL_iv.pageBlockParagraph || block instanceof TL_iv.pageBlockFooter) {
+            return result.put("type", block instanceof TL_iv.pageBlockParagraph ? "paragraph" : "footer")
+                    .put("text", richText(block.text));
+        }
+        if (block instanceof TL_iv.pageBlockPreformatted) {
+            result.put("type", "pre").put("text", richText(block.text));
+            String language = ((TL_iv.pageBlockPreformatted) block).language;
+            if (!language.isEmpty()) result.put("language", language);
+            return result;
+        }
+        if (block instanceof TL_iv.pageBlockDivider) return result.put("type", "divider");
+        if (block instanceof TL_iv.pageBlockBlockquoteBlocks) {
+            TL_iv.pageBlockBlockquoteBlocks quote = (TL_iv.pageBlockBlockquoteBlocks) block;
+            result.put("type", "blockquote").put("blocks", richBlocks(quote.blocks));
+            optionalRichText(result, "credit", quote.caption);
+            return result;
+        }
+        if (block instanceof TL_iv.pageBlockBlockquote) {
+            TL_iv.pageBlockBlockquote quote = (TL_iv.pageBlockBlockquote) block;
+            if (!quote.collapsed) throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_QUOTE");
+            result.put("type", "expandable_blockquote").put("text", richText(quote.text));
+            optionalRichText(result, "credit", quote.caption);
+            return result;
+        }
+        if (block instanceof TL_iv.pageBlockPullquote) {
+            TL_iv.pageBlockPullquote quote = (TL_iv.pageBlockPullquote) block;
+            result.put("type", "pullquote").put("text", richText(quote.text));
+            optionalRichText(result, "credit", quote.caption);
+            return result;
+        }
+        if (block instanceof TL_iv.pageBlockDetails) {
+            TL_iv.pageBlockDetails details = (TL_iv.pageBlockDetails) block;
+            result.put("type", "details").put("summary", richText(details.title))
+                    .put("blocks", richBlocks(details.blocks));
+            if (details.open) result.put("is_open", true);
+            return result;
+        }
+        if (block instanceof TL_iv.pageBlockTable) {
+            TL_iv.pageBlockTable table = (TL_iv.pageBlockTable) block;
+            result.put("type", "table");
+            optionalRichText(result, "caption", table.title);
+            if (table.bordered) result.put("is_bordered", true);
+            if (table.striped) result.put("is_striped", true);
+            if (table.compact) result.put("is_compact", true);
+            JSONArray rows = new JSONArray();
+            for (TL_iv.pageTableRow row : table.rows) {
+                JSONArray cells = new JSONArray();
+                for (TL_iv.pageTableCell cell : row.cells) {
+                    JSONObject data = new JSONObject()
+                            .put("align", cell.align_center ? "center" : cell.align_right ? "right" : "left")
+                            .put("valign", cell.valign_middle ? "middle" : cell.valign_bottom ? "bottom" : "top");
+                    optionalRichText(data, "text", cell.text);
+                    if (cell.header) data.put("is_header", true);
+                    if (cell.colspan > 1) data.put("colspan", cell.colspan);
+                    if (cell.rowspan > 1) data.put("rowspan", cell.rowspan);
+                    cells.put(data);
+                }
+                rows.put(cells);
+            }
+            return result.put("cells", rows);
+        }
+        throw new IllegalStateException("GRAMLAB_PROBE_UNKNOWN_RICH_BLOCK");
+    }
+
+    private static JSONObject richMessage(TL_iv.RichMessage value) throws Exception {
+        if (value.part || !value.photos.isEmpty() || !value.documents.isEmpty()) {
+            throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_RICH_MEDIA");
+        }
+        JSONObject result = new JSONObject().put("blocks", richBlocks(value.blocks));
+        if (value.rtl) result.put("is_rtl", true);
+        return result;
     }
 
