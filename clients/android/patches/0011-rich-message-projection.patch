+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.telegram.tgnet.tl.TL_iv;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Iterator;
+
+/** Strict semantic projection into the pinned client's original rich-message model. */
+public final class GramLabRichMessage {
+    private GramLabRichMessage() {}
+
+    private static void require(boolean condition) {
+        if (!condition) throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_RICH_MESSAGE");
+    }
+
+    private static void fields(JSONObject object, String... names) {
+        HashSet<String> allowed = new HashSet<>(Arrays.asList(names));
+        Iterator<String> keys = object.keys();
+        while (keys.hasNext()) require(allowed.contains(keys.next()));
+    }
+
+    private static String string(JSONObject object, String key) throws JSONException {
+        Object value = object.get(key);
+        require(value instanceof String);
+        return (String) value;
+    }
+
+    private static boolean flag(JSONObject object, String key) throws JSONException {
+        if (!object.has(key)) return false;
+        Object value = object.get(key);
+        require(value instanceof Boolean);
+        return (Boolean) value;
+    }
+
+    private static int positive(JSONObject object, String key) throws JSONException {
+        Object value = object.get(key);
+        require(value instanceof Integer || value instanceof Long);
+        long number = ((Number) value).longValue();
+        require(number > 0 && number <= Integer.MAX_VALUE);
+        return (int) number;
+    }
+
+    // Bound all JSON containers before recursion. These are the shared profile's resource
+    // limits, not a claim about the limits of the Telegram service.
+    private static void bounded(Object value, int depth, int[] remaining) throws JSONException {
+        require(depth <= 32 && --remaining[0] >= 0);
+        if (value instanceof JSONObject) {
+            JSONObject object = (JSONObject) value;
+            Iterator<String> keys = object.keys();
+            while (keys.hasNext()) {
+                String key = keys.next();
+                bounded(key, depth + 1, remaining);
+                bounded(object.get(key), depth + 1, remaining);
+            }
+        } else if (value instanceof JSONArray) {
+            JSONArray array = (JSONArray) value;
+            for (int i = 0; i < array.length(); i++) bounded(array.get(i), depth + 1, remaining);
+        } else if (value instanceof String) {
+            String text = (String) value;
+            remaining[1] -= text.getBytes(StandardCharsets.UTF_8).length;
+            require(remaining[1] >= 0);
+            for (int i = 0; i < text.length(); i++) {
+                char current = text.charAt(i);
+                require(current >= 32 || current == '\n' || current == '\t');
+                if (Character.isHighSurrogate(current)) {
+                    require(i + 1 < text.length() && Character.isLowSurrogate(text.charAt(++i)));
+                } else require(!Character.isLowSurrogate(current));
+            }
+        }
+    }
+
+    public static TL_iv.RichMessage decode(JSONObject record) throws JSONException {
+        bounded(record, 0, new int[] {10000, 65536});
+        fields(record, "blocks", "is_rtl");
+        TL_iv.RichMessage result = new TL_iv.RichMessage();
+        result.rtl = flag(record, "is_rtl");
+        result.blocks = blocks(record.getJSONArray("blocks"));
+        return result;
+    }
+
+    private static TL_iv.RichText text(Object value) throws JSONException {
+        if (value instanceof String) {
+            TL_iv.textPlain result = new TL_iv.textPlain();
+            result.text = (String) value;
+            return result;
+        }
+        if (value instanceof JSONArray) {
+            TL_iv.textConcat result = new TL_iv.textConcat();
+            JSONArray array = (JSONArray) value;
+            require(array.length() > 0);
+            for (int i = 0; i < array.length(); i++) result.texts.add(text(array.get(i)));
+            return result;
+        }
+        require(value instanceof JSONObject);
+        JSONObject record = (JSONObject) value;
+        fields(record, "type", "text");
+        TL_iv.RichText result;
+        switch (string(record, "type")) {
+            case "bold": result = new TL_iv.textBold(); break;
+            case "italic": result = new TL_iv.textItalic(); break;
+            case "underline": result = new TL_iv.textUnderline(); break;
+            case "strikethrough": result = new TL_iv.textStrike(); break;
+            case "spoiler": result = new TL_iv.textSpoiler(); break;
+            case "subscript": result = new TL_iv.textSubscript(); break;
+            case "superscript": result = new TL_iv.textSuperscript(); break;
+            case "marked": result = new TL_iv.textMarked(); break;
+            case "code": result = new TL_iv.textFixed(); break;
+            default: throw new IllegalArgumentException("GRAMLAB_BRIDGE_UNSUPPORTED_RICH_TEXT");
+        }
+        result.text = text(record.get("text"));
+        return result;
+    }
+
+    private static TL_iv.RichText optionalText(JSONObject record, String key) throws JSONException {
+        return record.has(key) ? text(record.get(key)) : new TL_iv.textEmpty();
+    }
+
+    private static ArrayList<TL_iv.PageBlock> blocks(JSONArray values) throws JSONException {
+        require(values.length() > 0);
+        ArrayList<TL_iv.PageBlock> result = new ArrayList<>();
+        for (int i = 0; i < values.length(); i++) result.add(block(values.getJSONObject(i)));
+        return result;
+    }
+
+    private static TL_iv.PageBlock block(JSONObject record) throws JSONException {
+        String type = string(record, "type");
+        TL_iv.PageBlock result;
+        switch (type) {
+            case "paragraph": case "footer":
+                fields(record, "type", "text");
+                result = type.equals("paragraph") ? new TL_iv.pageBlockParagraph() : new TL_iv.pageBlockFooter();
+                result.text = text(record.get("text"));
+                return result;
+            case "heading":
+                fields(record, "type", "text", "size");
+                switch (positive(record, "size")) {
+                    case 1: result = new TL_iv.pageBlockHeading1(); break;
+                    case 2: result = new TL_iv.pageBlockHeading2(); break;
+                    case 3: result = new TL_iv.pageBlockHeading3(); break;
+                    case 4: result = new TL_iv.pageBlockHeading4(); break;
+                    case 5: result = new TL_iv.pageBlockHeading5(); break;
+                    case 6: result = new TL_iv.pageBlockHeading6(); break;
+                    default: throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_RICH_HEADING");
+                }
+                result.text = text(record.get("text"));
+                return result;
+            case "pre": {
+                fields(record, "type", "text", "language");
+                TL_iv.pageBlockPreformatted pre = new TL_iv.pageBlockPreformatted();
+                pre.text = text(record.get("text"));
+                pre.language = record.has("language") ? string(record, "language") : "";
+                return pre;
+            }
+            case "divider":
+                fields(record, "type");
+                return new TL_iv.pageBlockDivider();
+            case "blockquote": {
+                fields(record, "type", "blocks", "credit");
+                TL_iv.pageBlockBlockquoteBlocks quote = new TL_iv.pageBlockBlockquoteBlocks();
+                quote.blocks = blocks(record.getJSONArray("blocks"));
+                quote.caption = optionalText(record, "credit");
+                return quote;
+            }
+            case "expandable_blockquote": {
+                fields(record, "type", "text", "credit");
+                TL_iv.pageBlockBlockquote quote = new TL_iv.pageBlockBlockquote();
+                quote.collapsed = true;
+                quote.text = text(record.get("text"));
+                quote.caption = optionalText(record, "credit");
+                return quote;
+            }
+            case "pullquote": {
+                fields(record, "type", "text", "credit");
+                TL_iv.pageBlockPullquote quote = new TL_iv.pageBlockPullquote();
+                quote.text = text(record.get("text"));
+                quote.caption = optionalText(record, "credit");
+                return quote;
+            }
+            case "details": {
+                fields(record, "type", "summary", "blocks", "is_open");
+                TL_iv.pageBlockDetails details = new TL_iv.pageBlockDetails();
+                details.title = text(record.get("summary"));
+                details.blocks = blocks(record.getJSONArray("blocks"));
+                details.open = flag(record, "is_open");
+                return details;
+            }
+            case "table": return table(record);
+            default: throw new IllegalArgumentException("GRAMLAB_BRIDGE_UNSUPPORTED_RICH_BLOCK");
+        }
+    }
+
+    private static TL_iv.pageBlockTable table(JSONObject record) throws JSONException {
+        fields(record, "type", "cells", "caption", "is_bordered", "is_striped", "is_compact");
+        TL_iv.pageBlockTable table = new TL_iv.pageBlockTable();
+        table.title = optionalText(record, "caption");
+        table.bordered = flag(record, "is_bordered");
+        table.striped = flag(record, "is_striped");
+        table.compact = flag(record, "is_compact");
+        JSONArray rows = record.getJSONArray("cells");
+        require(rows.length() > 0);
+        int firstWidth = 0;
+        int area = 0;
+        for (int i = 0; i < rows.length(); i++) {
+            JSONArray values = rows.getJSONArray(i);
+            require(values.length() > 0);
+            TL_iv.pageTableRow row = new TL_iv.pageTableRow();
+            int width = 0;
+            for (int j = 0; j < values.length(); j++) {
+                TL_iv.pageTableCell cell = cell(values.getJSONObject(j));
+                int columns = Math.max(cell.colspan, 1);
+                width += columns;
+                area += columns * Math.max(cell.rowspan, 1);
+                require(area <= 10000);
+                row.cells.add(cell);
+            }
+            if (i == 0) firstWidth = width;
+            // The pinned renderer uses the first row for TableLayout's column count.
+            require(width <= firstWidth);
+            table.rows.add(row);
+        }
+        return table;
+    }
+
+    private static TL_iv.pageTableCell cell(JSONObject record) throws JSONException {
+        fields(record, "text", "is_header", "colspan", "rowspan", "align", "valign");
+        TL_iv.pageTableCell cell = new TL_iv.pageTableCell();
+        cell.header = flag(record, "is_header");
+        if (record.has("text")) {
+            cell.text = text(record.get("text"));
+            cell.flags |= 1 << 7;
+        }
+        if (record.has("colspan")) {
+            cell.colspan = positive(record, "colspan");
+            require(cell.colspan <= 100);
+            cell.flags |= 1 << 1;
+        }
+        if (record.has("rowspan")) {
+            cell.rowspan = positive(record, "rowspan");
+            require(cell.rowspan <= 100);
+            cell.flags |= 1 << 2;
+        }
+        String align = record.has("align") ? string(record, "align") : (cell.header ? "center" : "left");
+        require(align.equals("left") || align.equals("center") || align.equals("right"));
+        cell.align_center = align.equals("center");
+        cell.align_right = align.equals("right");
+        String valign = record.has("valign") ? string(record, "valign") : "middle";
+        require(valign.equals("top") || valign.equals("middle") || valign.equals("bottom"));
+        cell.valign_middle = valign.equals("middle");
+        cell.valign_bottom = valign.equals("bottom");
+        return cell;
+    }
+}
