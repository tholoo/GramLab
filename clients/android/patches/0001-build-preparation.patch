diff --git a/TMessagesProj_GramLab/build.gradle b/TMessagesProj_GramLab/build.gradle
new file mode 100644
index 00000000..eea90205
--- /dev/null
+++ b/TMessagesProj_GramLab/build.gradle
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+apply plugin: 'com.android.application'
+
+repositories {
+    google()
+    mavenCentral()
+}
+
+dependencies {
+    implementation project(':TMessagesProj')
+    coreLibraryDesugaring 'com.android.tools:desugar_jdk_libs:2.1.5'
+    implementation files('../TMessagesProj/libs/libgsaverification-client.aar')
+}
+
+android {
+    namespace 'org.gramlab.android'
+    compileSdk 36
+    buildToolsVersion '36.0.0'
+    ndkVersion '27.2.12479018'
+    defaultConfig {
+        applicationId 'org.gramlab.android'
+        minSdk 23
+        targetSdk 36
+        versionCode 1
+        versionName '0.0.0-offline'
+        ndk { abiFilters 'x86_64' }
+    }
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_1_8
+        targetCompatibility JavaVersion.VERSION_1_8
+        coreLibraryDesugaringEnabled true
+    }
+    signingConfigs {
+        debug {
+            storeFile rootProject.file('.gramlab/debug.keystore')
+            storePassword 'android'
+            keyAlias 'gramlab-debug'
+            keyPassword 'android'
+        }
+    }
+    buildTypes {
+        debug {
+            debuggable true
+            minifyEnabled false
+            signingConfig signingConfigs.debug
+        }
+    }
+}
