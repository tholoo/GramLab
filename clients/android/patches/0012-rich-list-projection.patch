+    private static TL_iv.PageBlock list(JSONObject record) throws JSONException {
+        fields(record, "type", "items");
+        require(record.opt("items") instanceof JSONArray);
+        JSONArray items = record.getJSONArray("items");
+        require(items.length() > 0 && items.opt(0) instanceof JSONObject);
+        boolean ordered = items.getJSONObject(0).has("type");
+        TL_iv.pageBlockList unorderedList = ordered ? null : new TL_iv.pageBlockList();
+        TL_iv.pageBlockOrderedList orderedList = ordered ? new TL_iv.pageBlockOrderedList() : null;
+        for (int i = 0; i < items.length(); i++) {
+            require(items.opt(i) instanceof JSONObject);
+            JSONObject recordItem = items.getJSONObject(i);
+            fields(recordItem, "label", "blocks", "has_checkbox", "is_checked", "type", "value");
+            require(recordItem.has("type") == ordered);
+            require(recordItem.opt("label") instanceof String);
+            require(recordItem.opt("blocks") instanceof JSONArray);
+            boolean checkbox = listFlag(recordItem, "has_checkbox");
+            boolean checked = listFlag(recordItem, "is_checked");
+            require(!checked || checkbox);
+            // Only list-item blocks may be empty; top-level and other blocks remain nonempty.
+            JSONArray children = recordItem.getJSONArray("blocks");
+            ArrayList<TL_iv.PageBlock> nested = new ArrayList<>();
+            for (int j = 0; j < children.length(); j++) {
+                require(children.opt(j) instanceof JSONObject);
+                nested.add(block(children.getJSONObject(j)));
+            }
+            if (ordered) {
+                String type = string(recordItem, "type");
+                require(type.equals("1") || type.equals("a") || type.equals("A")
+                        || type.equals("i") || type.equals("I"));
+                int value = listValue(recordItem);
+                String label = string(recordItem, "label");
+                require(label.equals(listLabel(value, type)));
+                TL_iv.TL_pageListOrderedItemBlocks item = new TL_iv.TL_pageListOrderedItemBlocks();
+                item.blocks = nested;
+                item.checkbox = checkbox;
+                item.checked = checked;
+                item.num = label;
+                item.value = value;
+                item.type = type;
+                // Number, value and type are present even when the integer value is zero.
+                item.flags = (1 << 2) | (1 << 3) | (1 << 4);
+                orderedList.items.add(item);
+            } else {
+                require(!recordItem.has("value") && string(recordItem, "label").equals("•"));
+                TL_iv.TL_pageListItemBlocks item = new TL_iv.TL_pageListItemBlocks();
+                item.blocks = nested;
+                item.checkbox = checkbox;
+                item.checked = checked;
+                unorderedList.items.add(item);
+            }
+        }
+        // Bot API exposes per-item ordering only, never native start/reversed/type flags.
+        return ordered ? orderedList : unorderedList;
     }
 
