+    private static int listValue(JSONObject record) throws JSONException {
+        Object raw = record.opt("value");
+        require(raw instanceof Integer || raw instanceof Long);
+        long value = ((Number) raw).longValue();
+        require(value >= Integer.MIN_VALUE && value <= Integer.MAX_VALUE);
+        return (int) value;
+    }
+
+    private static boolean listFlag(JSONObject record, String name) throws JSONException {
+        // Canonical output omits false flags; accepting them would silently normalize data.
+        require(!record.has(name) || Boolean.TRUE.equals(record.get(name)));
+        return record.has(name);
+    }
+
+    private static String listLabel(int value, String type) {
+        String label = Integer.toString(value);
+        if (value > 0 && (type.equals("a") || type.equals("A"))) {
+            StringBuilder letters = new StringBuilder();
+            for (int number = value; number > 0; number /= 26) {
+                number--;
+                letters.append((char) ((type.equals("a") ? 'a' : 'A') + number % 26));
+            }
+            label = letters.reverse().toString();
+        } else if (value > 0 && value < 4000 && (type.equals("i") || type.equals("I"))) {
+            int[] amounts = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
+            String[] symbols = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
+            StringBuilder roman = new StringBuilder();
+            int remaining = value;
+            for (int i = 0; i < amounts.length; i++) {
+                while (remaining >= amounts[i]) {
+                    remaining -= amounts[i];
+                    roman.append(symbols[i]);
+                }
+            }
+            label = roman.toString();
+            if (type.equals("i")) label = label.toLowerCase(java.util.Locale.ROOT);
+        }
+        return label + ".";
+    }
