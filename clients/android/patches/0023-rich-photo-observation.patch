+    private JSONObject observeTarget(ChatMessageCell cell, Target target) throws Exception {
+        MessageObject message = cell.getMessageObject();
+        if ("ordinary".equals(target.kind)) {
+            require(message.messageOwner.media instanceof TLRPC.TL_messageMediaPhoto
+                    && message.messageOwner.media.photo != null
+                    && target.assetIds.contains(message.messageOwner.media.photo.id), "asset_mismatch");
+            long assetId = message.messageOwner.media.photo.id;
+            return observeCell(cell, target.messageId).put("kind", target.kind)
+                    .put("asset_id", assetId);
+        }
+
+        require(cell.getClass() == ChatMessageCell.class && message.type == MessageObject.TYPE_ARTICLE
+                && message.richLayout != null && message.messageOwner.rich_message != null
+                && cell.getCurrentMessagesGroup() == null && !message.hasMediaSpoilers(),
+                "unsupported_photo");
+        for (View view = cell; view != null;) {
+            require(view.getMatrix().isIdentity() && view.getAlpha() == 1
+                    && view.getScrollX() == 0 && view.getScrollY() == 0, "unsupported_transform");
+            ViewParent parent = view.getParent();
+            view = parent instanceof View ? (View) parent : null;
+        }
+        require(!cell.getTransitionParams().animateChange && !cell.getTransitionParams().messageEntering
+                && cell.getDeltaTop() == 0 && cell.getDeltaLeft() == 0
+                && cell.getDeltaRight() == 0 && cell.getDeltaBottom() == 0
+                && cell.getPaddingTopAnimated() == cell.getPaddingTop()
+                && !message.richLayout.detailsAnimating && !message.richLayout.blockquoteAnimating,
+                "unsupported_transform");
+
+        RichMessageLayout.RichPhotoBlock match = null;
+        for (RichMessageLayout.RichBlock block : message.richLayout.blocks) {
+            if (!(block instanceof RichMessageLayout.RichPhotoBlock)) continue;
+            RichMessageLayout.RichPhotoBlock photo = (RichMessageLayout.RichPhotoBlock) block;
+            if (photo.photo != null && photo.block.photo_id == photo.photo.id
+                    && target.assetIds.contains(photo.photo.id)) {
+                require(match == null, "ambiguous_photo");
+                match = photo;
+            }
+        }
+        require(match != null && match.sizeFull != null && match.currVisible, "unsupported_photo");
+        ImageReceiver image = match.imageReceiver;
+
+        require(image.getAnimation() == null && image.getAlpha() == 1
+                && image.getCurrentAlpha() == 1, "unsupported_photo");
+
+        int[] origin = new int[2];
+        cell.getLocationOnScreen(origin);
+        RectF cellBounds = new RectF(origin[0], origin[1], origin[0] + cell.getWidth(),
+                origin[1] + cell.getHeight());
+        Rect visible = new Rect();
+        require(cell.getGlobalVisibleRect(visible), "message_not_unique_or_visible");
+        int[] rootOrigin = new int[2];
+        cell.getRootView().getLocationOnScreen(rootOrigin);
+        visible.offset(rootOrigin[0], rootOrigin[1]);
+        RectF visibleBounds = new RectF(visible);
+        float blockX = origin[0] + cell.getTextX() + match.padding.left;
+        float blockY = origin[1] + cell.getPaddingTopAnimated() + cell.getTextY()
+                + match.currY + match.padding.top;
+        RectF imageBounds = new RectF(image.getImageX(), image.getImageY(),
+                image.getImageX2(), image.getImageY2());
+        imageBounds.offset(blockX, blockY);
+        int imageWidth = match.maxWidth;
+        float scale = imageWidth / (float) Math.max(1, match.sizeFull.w);
+        int imageHeight = (int) (scale * match.sizeFull.h);
+        int maxHeight = (int) (Math.max(AndroidUtilities.displaySize.x,
+                AndroidUtilities.displaySize.y) * 0.55f);
+        if (imageHeight > maxHeight) {
