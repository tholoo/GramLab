+                throw invalid();
+            JSONObject provenance = (JSONObject) parsed;
+            exact(provenance, "schema", "revision", "occurrences");
+            if (positive(provenance, "schema") != 1
+                    || positive(provenance, "revision") != message.gramLabRichButtonRevision
