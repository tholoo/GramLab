+    private static Object canonicalButtonLabel(TL_iv.RichText text) throws Exception {
+        if (text instanceof TL_iv.textPlain) return ((TL_iv.textPlain) text).text;
+        if (text instanceof TL_iv.textCustomEmoji) {
+            TL_iv.textCustomEmoji emoji = (TL_iv.textCustomEmoji) text;
+            return new JSONObject().put("type", "custom_emoji")
+                    .put("custom_emoji_id", Long.toString(emoji.document_id))
+                    .put("alternative_text", emoji.alt);
+        }
+        if (text instanceof TL_iv.textConcat) {
+            JSONArray result = new JSONArray();
+            for (TL_iv.RichText part : text.texts) result.put(canonicalButtonLabel(part));
+            return result;
+        }
+        throw invalid();
+    }
