+    private static void collectFinalText(TL_iv.RichText text, JSONArray path,
+            java.util.ArrayList<FinalObject> out) {
+        if (text == null) return;
+        if (text instanceof TL_iv.textButton) { out.add(new FinalObject(text, append(path, "button"))); return; }
+        if (text instanceof TL_iv.textConcat) {
+            for (int i = 0; i < text.texts.size(); i++)
+                collectFinalText(text.texts.get(i), append(path, i), out);
+        } else {
+            collectFinalText(text.text, append(path, "text"), out);
+        }
+    }
