+    private static boolean buttonKindMatches(JSONObject button, Object object) {
+        try {
+            TL_iv.RichText label;
+            TL_keyboard.InlineButtonType type;
+            TL_keyboard.RichButtonStyle style;
+            int flags;
+            if (object instanceof TL_keyboard.PageButton) {
+                TL_keyboard.PageButton value = (TL_keyboard.PageButton) object;
+                label = value.text; type = value.type; style = value.style; flags = value.flags;
+            } else {
+                TL_iv.textButton value = (TL_iv.textButton) object;
+                label = value.text; type = value.type; style = value.style; flags = value.flags;
+            }
+            if (flags != (style == null ? 0 : 1)) return false;
+            JSONObject actual = new JSONObject().put("text", canonicalButtonLabel(label));
+            if (type instanceof TL_keyboard.TL_inlineButtonTypeCallback) {
+                TL_keyboard.TL_inlineButtonTypeCallback callback =
+                        (TL_keyboard.TL_inlineButtonTypeCallback) type;
+                if (callback.flags != 0 || callback.requires_password) return false;
+                byte[] data = callback.data;
+                String decoded = StandardCharsets.UTF_8.newDecoder()
+                        .onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+                        .decode(java.nio.ByteBuffer.wrap(data)).toString();
+                actual.put("callback_data", decoded);
+            } else if (type instanceof TL_keyboard.TL_inlineButtonTypeCopy) {
+                actual.put("copy_text", new JSONObject().put("text",
+                        ((TL_keyboard.TL_inlineButtonTypeCopy) type).copy_text));
+            } else if (type instanceof TL_keyboard.TL_inlineButtonTypeDisabled) {
+                actual.put("disabled", new JSONObject());
+            } else return false;
+            if (style != null) {
+                int count = (style.bg_primary ? 1 : 0) + (style.bg_danger ? 1 : 0)
+                        + (style.bg_success ? 1 : 0) + (style.link ? 1 : 0);
+                int styleFlags = (style.bg_primary ? 1 : 0) | (style.bg_danger ? 2 : 0)
+                        | (style.bg_success ? 4 : 0) | (style.link ? 8 : 0);
+                if (count != 1 || style.flags != styleFlags) return false;
+                actual.put("style", style.bg_primary ? "primary" : style.bg_danger ? "danger"
+                        : style.bg_success ? "success" : "link");
+            }
+            return button.toString().equals(actual.toString());
+        } catch (Exception failure) {
+            return false;
+        }
+    }
