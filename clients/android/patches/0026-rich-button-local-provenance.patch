+    private static void collectFinalBlocks(java.util.List<TL_iv.PageBlock> blocks, JSONArray path,
+            java.util.ArrayList<FinalObject> out) {
+        if (blocks == null) return;
+        for (int i = 0; i < blocks.size(); i++) {
+            TL_iv.PageBlock block = blocks.get(i);
+            JSONArray current = append(path, i);
+            if (block instanceof TL_iv.pageBlockButtonRow) {
+                java.util.List<TL_keyboard.PageButton> buttons = ((TL_iv.pageBlockButtonRow) block).buttons;
+                for (int j = 0; j < buttons.size(); j++)
+                    out.add(new FinalObject(buttons.get(j), append(append(current, "buttons"), j)));
+            } else if (block instanceof TL_iv.pageBlockBlockquoteBlocks) {
+                TL_iv.pageBlockBlockquoteBlocks quote = (TL_iv.pageBlockBlockquoteBlocks) block;
+                collectFinalBlocks(quote.blocks, append(current, "blocks"), out);
+                collectFinalText(quote.caption, append(current, "credit"), out);
+            } else if (block instanceof TL_iv.pageBlockDetails) {
+                TL_iv.pageBlockDetails details = (TL_iv.pageBlockDetails) block;
+                collectFinalText(details.title, append(current, "summary"), out);
+                collectFinalBlocks(details.blocks, append(current, "blocks"), out);
+            } else if (block instanceof TL_iv.pageBlockList) {
+                java.util.List<TL_iv.PageListItem> items = ((TL_iv.pageBlockList) block).items;
+                for (int j = 0; j < items.size(); j++) {
+                    TL_iv.PageListItem item = items.get(j);
+                    if (item instanceof TL_iv.TL_pageListItemBlocks)
+                        collectFinalBlocks(((TL_iv.TL_pageListItemBlocks) item).blocks,
+                                append(append(append(current, "items"), j), "blocks"), out);
+                }
+            } else if (block instanceof TL_iv.pageBlockTable) {
+                TL_iv.pageBlockTable table = (TL_iv.pageBlockTable) block;
+                collectFinalText(table.title, append(current, "caption"), out);
+                for (int row = 0; row < table.rows.size(); row++)
+                    for (int cell = 0; cell < table.rows.get(row).cells.size(); cell++)
+                        collectFinalText(table.rows.get(row).cells.get(cell).text,
+                                append(append(append(append(current, "cells"), row), cell), "text"), out);
+            } else if (block instanceof TL_iv.pageBlockPhoto) {
+                if (block.caption != null) {
+                    collectFinalText(block.caption.text, append(append(current, "caption"), "text"), out);
+                    collectFinalText(block.caption.credit, append(append(current, "caption"), "credit"), out);
+                }
+            } else {
+                collectFinalText(block.text, append(current, "text"), out);
+                if (block instanceof TL_iv.pageBlockBlockquote)
+                    collectFinalText(((TL_iv.pageBlockBlockquote) block).caption, append(current, "credit"), out);
+                else if (block instanceof TL_iv.pageBlockPullquote)
+                    collectFinalText(((TL_iv.pageBlockPullquote) block).caption, append(current, "credit"), out);
+            }
+        }
+    }
