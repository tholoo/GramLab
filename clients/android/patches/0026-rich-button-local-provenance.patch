+                    .put("occurrences", occurrences).toString().getBytes(StandardCharsets.UTF_8);
+            if (bytes.length > MAX_PRIVATE_BYTES)
+                throw invalid();
+            message.gramLabRichButtonRevision = revision;
+            message.gramLabRichButtonProvenance = bytes.clone();
+        } catch (Exception failure) {
+            message.gramLabRichButtonRevision = 0;
+            message.gramLabRichButtonProvenance = null;
