--- /dev/null
+++ b/TMessagesProj_GramLab/src/main/java/org/telegram/tgnet/NativeGuardProbe.java
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.tgnet;
+
+/** app_process probe: never starts ApplicationLoader or a Telegram account. */
+public final class NativeGuardProbe {
+    private static boolean rejected(Runnable operation) {
+        try {
+            operation.run();
+            return false;
+        } catch (IllegalStateException failure) {
+            if (!"GRAMLAB_NATIVE_TRANSPORT_DISABLED".equals(failure.getMessage())) {
+                throw failure;
+            }
+            return true;
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        System.load(args[0]);
+        // No native_init: the baseline only queues this opaque pointer, with no network worker.
+        boolean request = rejected(() -> ConnectionsManager.native_sendRequest(
+                0, 0L, 0, 0, 1, true, 1));
+        if (!request) {
+            System.out.println("{\"request_blocked\":false}");
+            System.exit(2);
+        }
+        // Null metadata makes any unguarded path fail before transport initialization.
+        boolean initialization = rejected(() -> ConnectionsManager.native_init(
+                0, 0, 0, 0, null, null, null, null, null, null, null, null, null, null, null,
+                0, 0L, false, false, false, 0, 0));
+        // Preserve upstream JNI memory operations needed by storage and rendering.
+        ConnectionsManager.native_setJava(false);
+        NativeByteBuffer buffer = new NativeByteBuffer(4);
+        buffer.writeInt32(0x12345678);
+        buffer.position(0);
+        boolean memory = buffer.readInt32(true) == 0x12345678;
+        buffer.reuse();
+        System.out.println("{\"request_blocked\":" + request
+                + ",\"initialization_blocked\":" + initialization
+                + ",\"buffer_round_trip\":" + memory + "}");
+        System.exit(request && initialization && memory ? 0 : 3);
+    }
+}
