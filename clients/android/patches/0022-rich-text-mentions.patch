+    private static JSONObject observeMessage(TLRPC.Message message) throws Exception {
+        JSONObject observed = new JSONObject().put("id", message.id)
+                .put("sender_id", message.from_id.user_id)
+                .put("recipient_id", message.peer_id.user_id).put("out", message.out)
+                .put("date", message.date).put("text", message.message);
+        if (!message.entities.isEmpty()) {
+            JSONArray entities = new JSONArray();
+            for (TLRPC.MessageEntity entity : message.entities) {
+                JSONObject value = new JSONObject().put("kind", entity.getClass().getSimpleName())
+                        .put("offset", entity.offset).put("length", entity.length);
+                if (entity instanceof TLRPC.TL_messageEntityPre) value.put("language", entity.language);
+                if (entity instanceof TLRPC.TL_messageEntityBlockquote) value.put("collapsed", entity.collapsed);
+                entities.put(value);
+            }
+            observed.put("entities", entities);
+        }
+        if (message.rich_message != null) {
+            observed.put("rich_message", richMessage(message.rich_message));
+        }
+        if (message.media instanceof TLRPC.TL_messageMediaPhoto) {
+            observed.put("native_photo", GramLabMedia.describePhoto(message.media.photo));
+        }
+        return observed;
+    }
+
+    private static JSONArray observeUsers(java.util.List<TLRPC.User> values) throws Exception {
+        JSONArray users = new JSONArray();
+        for (TLRPC.User user : values) {
+            users.put(new JSONObject().put("id", user.id).put("first_name", user.first_name)
+                    .put("self", user.self).put("bot", user.bot)
+                    .put("username", user.username == null ? JSONObject.NULL : user.username)
+                    .put("language_code", user.lang_code == null ? JSONObject.NULL : user.lang_code)
+                    .put("phone", user.phone == null ? JSONObject.NULL : user.phone));
+        }
+        return users;
+    }
+
+    private static JSONArray observeUpdates(java.util.List<TLRPC.Update> values) throws Exception {
+        JSONArray result = new JSONArray();
+        for (TLRPC.Update value : values) {
+            TLRPC.Message message;
+            int pts;
+            int count;
+            if (value instanceof TL_update.TL_updateNewMessage) {
+                TL_update.TL_updateNewMessage update = (TL_update.TL_updateNewMessage) value;
+                message = update.message; pts = update.pts; count = update.pts_count;
+            } else if (value instanceof TL_update.TL_updateEditMessage) {
+                TL_update.TL_updateEditMessage update = (TL_update.TL_updateEditMessage) value;
+                message = update.message; pts = update.pts; count = update.pts_count;
+            } else throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_UPDATE");
+            result.put(new JSONObject().put("kind", value.getClass().getSimpleName())
+                    .put("pts", pts).put("pts_count", count).put("message", observeMessage(message)));
+        }
+        return result;
+    }
