diff --git a/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabRuntime.java b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabRuntime.java
new file mode 100644
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/gramlab/GramLabRuntime.java
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import android.content.Context;
+import android.os.SystemClock;
+import org.json.JSONObject;
+import org.telegram.messenger.BuildConfig;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.Utilities;
+import org.telegram.tgnet.RequestDelegate;
+import org.telegram.tgnet.RequestDelegateTimestamp;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.Vector;
+import org.telegram.tgnet.tl.TL_bots;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+
+/** Synthetic application binding and semantic request lifecycle. Never invokes native transport. */
+public final class GramLabRuntime {
+    private static volatile GramLabBridge.Snapshot snapshot;
+    private static JSONObject configuration;
+    private static File directory;
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor(
+            action -> new Thread(action, "GramLabBridge"));
+    private static final Map<Long, Pending> pending = new ConcurrentHashMap<>();
+
+    private static final class Pending {
+        final int account;
+        volatile int guid;
+        Pending(int account) { this.account = account; }
+    }
+
+    private static final class StartupRejected extends Exception {
+        final String reason;
+        StartupRejected(String reason) { this.reason = reason; }
+    }
+
+    public static boolean enabled() { return BuildConfig.GRAMLAB_OFFLINE; }
+
+    private static long key(int account, int token) {
+        return ((long) account << 32) | (token & 0xffffffffL);
+    }
+
+    public static synchronized void initialize(Context context) {
+        if (snapshot != null) return;
+        directory = new File(context.getFilesDir(), "gramlab");
+        try {
+            Files.createDirectories(directory.toPath());
+            File input = new File(directory, "config.json");
+            if (!input.isFile()) throw new StartupRejected("configuration_missing");
+            if (input.length() > 16384) throw new StartupRejected("configuration_too_large");
+            configuration = new JSONObject(new String(Files.readAllBytes(input.toPath()),
+                    StandardCharsets.UTF_8));
+            GramLabBridge.Snapshot loaded = worker.submit(
+                    () -> GramLabBridge.connect(configuration)).get(10, TimeUnit.SECONDS);
+            File binding = new File(directory, "binding.json");
+            if (binding.exists()) {
+                JSONObject previous = new JSONObject(new String(
+                        Files.readAllBytes(binding.toPath()), StandardCharsets.UTF_8));
+                if (!loaded.worldId.equals(previous.getString("world_id"))
+                        || loaded.persona != previous.getLong("user_id")) {
+                    throw new StartupRejected("world_binding_mismatch");
+                }
+            } else {
+                JSONObject identity = new JSONObject().put("world_id", loaded.worldId)
+                        .put("user_id", loaded.persona);
+                File temporary = new File(directory, "binding.tmp");
+                Files.write(temporary.toPath(), identity.toString().getBytes(StandardCharsets.UTF_8));
+                Files.move(temporary.toPath(), binding.toPath(),
+                        java.nio.file.StandardCopyOption.ATOMIC_MOVE);
+            }
+            snapshot = loaded;
+            trace("initialized", "snapshot", 0, 0);
+        } catch (Exception failure) {
+            String reason = failure instanceof StartupRejected
+                    ? ((StartupRejected) failure).reason : "configuration_unavailable";
+            trace("startup_rejected", reason, 0, 0);
+            // Never retain a cause: parsers and transports can include private configuration.
+            throw new IllegalStateException("GRAMLAB_STARTUP_REJECTED_" + reason);
+        }
+    }
+
+    public static void installPersona() {
+        GramLabBridge.Snapshot current = requireSnapshot();
+        UserConfig.selectedAccount = 0;
+        UserConfig userConfig = UserConfig.getInstance(0);
+        userConfig.loadConfig();
+        if (userConfig.isClientActivated() && userConfig.getClientUserId() != current.persona) {
+            throw new IllegalStateException("GRAMLAB_CLIENT_IDENTITY_MISMATCH");
+        }
+        userConfig.setCurrentUser(user(current, current.persona));
+        userConfig.saveConfig(true);
+        // ChatActivity resolves its peer from the controller before requesting history.
+        MessagesController.getInstance(0).putUsers(current.dialogs.users, false);
+        // Seed the normal dialog cache before ChatActivity asks for cached history.
+        // check=2 preserves existing pinned state and closes only the supplied message hole.
+        MessagesStorage storage = MessagesStorage.getInstance(0);
+        storage.putDialogs(current.dialogs, 2);
+        CountDownLatch stored = new CountDownLatch(1);
+        storage.getStorageQueue().postRunnable(stored::countDown);
+        try {
+            if (!stored.await(10, TimeUnit.SECONDS)) {
+                throw new IllegalStateException("GRAMLAB_DIALOG_CACHE_TIMEOUT");
+            }
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("GRAMLAB_DIALOG_CACHE_INTERRUPTED");
+        }
+    }
+
+    private static GramLabBridge.Snapshot requireSnapshot() {
+        GramLabBridge.Snapshot current = snapshot;
+        if (current == null) throw new IllegalStateException("GRAMLAB_NOT_INITIALIZED");
+        return current;
+    }
+
+    public static int now() { return requireSnapshot().now; }
+
+    public static synchronized void trace(String event, String method, int account, int token) {
+        if (directory == null) return;
+        try {
+            JSONObject record = new JSONObject().put("event", event).put("method", method)
+                    .put("account", account).put("token", token)
+                    .put("elapsed_ms", SystemClock.elapsedRealtime());
+            Files.write(new File(directory, "trace.jsonl").toPath(),
+                    (record + "\n").getBytes(StandardCharsets.UTF_8),
+                    java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
+        } catch (Exception failure) {
+            throw new IllegalStateException("GRAMLAB_TRACE_WRITE_FAILED");
+        }
+    }
+
+    public static void reserve(int account, int token) {
+        pending.put(key(account, token), new Pending(account));
+    }
+
+    public static void bind(int account, int token, int guid) {
+        if (guid == 0) return;
+        Pending request = pending.get(key(account, token));
+        if (request != null) request.guid = guid;
+    }
+
+    public static void cancel(int account, int token, Runnable onCancelled) {
+        pending.remove(key(account, token));
+        if (onCancelled != null) Utilities.stageQueue.postRunnable(onCancelled);
+    }
+
+    public static void cancelGuid(int account, int guid) {
+        if (guid == 0) return;
+        pending.entrySet().removeIf(entry -> entry.getValue().account == account
+                && entry.getValue().guid == guid);
+    }
+
+    public static void cleanup(int account) {
+        pending.entrySet().removeIf(entry -> entry.getValue().account == account);
+    }
+
+    public static void request(int account, int token, TLObject request,
+            RequestDelegate completion, RequestDelegateTimestamp timestamped) {
+        long key = key(account, token);
+        Pending owner = pending.get(key);
+        if (owner == null) {
+            request.freeResources();
+            return;
+        }
+        String method = request.getClass().getSimpleName();
+        trace("request", method, account, token);
+        worker.execute(() -> {
+            TLObject response = null;
+            TLRPC.TL_error error = null;
+            try {
+                if (account != 0) throw new UnsupportedOperationException();
+                if (!(request instanceof TLRPC.TL_messages_getDialogs
+                        || request instanceof TLRPC.TL_messages_getHistory
+                        || request instanceof TLRPC.TL_users_getUsers
+                        || request instanceof TLRPC.TL_users_getFullUser)) {
+                    throw new UnsupportedOperationException();
+                }
+                GramLabBridge.Snapshot current = GramLabBridge.connect(configuration);
+                snapshot = current;
+                response = dispatch(request, current);
+            } catch (UnsupportedOperationException unsupported) {
+                error = new TLRPC.TL_error();
+                error.code = 501;
+                error.text = "GRAMLAB_UNSUPPORTED_" + method;
+            } catch (IllegalArgumentException invalid) {
+                error = new TLRPC.TL_error();
+                error.code = 400;
+                error.text = "GRAMLAB_INVALID_REQUEST";
+            } catch (Exception unavailable) {
+                error = new TLRPC.TL_error();
+                error.code = 503;
+                error.text = "GRAMLAB_BRIDGE_UNAVAILABLE";
+            }
+            final TLObject result = response;
+            final TLRPC.TL_error failure = error;
+            Utilities.stageQueue.postRunnable(() -> {
+                try {
+                    if (!pending.remove(key, owner)) return;
+                    trace(failure == null ? "response" : "error_" + failure.code,
+                            method, account, token);
+                    if (completion != null) completion.run(result, failure);
+                    if (timestamped != null) timestamped.run(result, failure, now() * 1000L);
+                } finally {
+                    request.freeResources();
+                }
+            });
+        });
+    }
+
+    private static TLRPC.User user(GramLabBridge.Snapshot current, long id) {
+        for (TLRPC.User candidate : current.dialogs.users) {
+            if (candidate.id == id) return candidate;
+        }
+        throw new IllegalArgumentException("Unknown synthetic participant");
+    }
+
+    private static long userId(TLRPC.InputUser user, GramLabBridge.Snapshot current) {
+        return user instanceof TLRPC.TL_inputUserSelf ? current.persona : user.user_id;
+    }
+
+    private static TLObject dispatch(TLObject request, GramLabBridge.Snapshot current) {
+        if (request instanceof TLRPC.TL_messages_getDialogs) {
+            TLRPC.TL_messages_getDialogs query = (TLRPC.TL_messages_getDialogs) request;
+            if (query.folder_id != 0 || query.offset_id != 0 || query.offset_date != 0
+                    || query.limit < current.dialogs.dialogs.size()) {
+                throw new UnsupportedOperationException();
+            }
+            return current.dialogs;
+        }
+        if (request instanceof TLRPC.TL_messages_getHistory) {
+            TLRPC.TL_messages_getHistory query = (TLRPC.TL_messages_getHistory) request;
+            if (query.peer == null || query.peer.user_id == 0 || query.add_offset != 0
+                    || query.offset_date != 0 || query.limit <= 0 || query.limit > 100) {
+                throw new UnsupportedOperationException();
+            }
+            TLRPC.TL_messages_messages source = current.histories.get(query.peer.user_id);
+            if (source == null) throw new IllegalArgumentException();
+            TLRPC.TL_messages_messages result = new TLRPC.TL_messages_messages();
+            result.users.addAll(source.users);
+            for (TLRPC.Message message : source.messages) {
+                if (query.offset_id > 0 && message.id >= query.offset_id
+                        || query.max_id > 0 && message.id >= query.max_id
+                        || query.min_id > 0 && message.id <= query.min_id) continue;
+                if (result.messages.size() == query.limit) break;
+                result.messages.add(message);
+            }
+            return result;
+        }
+        if (request instanceof TLRPC.TL_users_getUsers) {
+            Vector<TLRPC.User> result = new Vector<>(TLRPC.User::TLdeserialize);
+            for (TLRPC.InputUser id : ((TLRPC.TL_users_getUsers) request).id) {
+                result.objects.add(user(current, userId(id, current)));
+            }
+            return result;
+        }
+        if (request instanceof TLRPC.TL_users_getFullUser) {
+            TLRPC.User user = user(current,
+                    userId(((TLRPC.TL_users_getFullUser) request).id, current));
+            TLRPC.TL_users_userFull result = new TLRPC.TL_users_userFull();
+            result.users.add(user);
+            TLRPC.TL_userFull full = new TLRPC.TL_userFull();
+            full.id = user.id;
+            full.settings = new TLRPC.TL_peerSettings();
+            full.notify_settings = new TLRPC.TL_peerNotifySettings();
+            if (user.bot) {
+                TL_bots.TL_botInfo info = new TL_bots.TL_botInfo();
+                info.user_id = user.id;
+                info.description = "";
+                info.flags = 1 | 2 | 4;
+                full.bot_info = info;
+                full.flags |= 1 << 3;
+            }
+            result.full_user = full;
+            return result;
+        }
+        throw new UnsupportedOperationException();
+    }
+}
