+    private static boolean boundary(String text, int index) {
+        return index >= 0 && index <= text.length() && !(index > 0 && index < text.length()
+                && Character.isHighSurrogate(text.charAt(index - 1))
+                && Character.isLowSurrogate(text.charAt(index)));
+    }
+
+    private static ArrayList<TLRPC.MessageEntity> entities(JSONArray values, String text) throws JSONException {
+        ArrayList<TLRPC.MessageEntity> result = new ArrayList<>();
+        for (int index = 0; index < values.length(); index++) {
+            JSONObject record = values.getJSONObject(index);
+            require(record.get("type") instanceof String);
+            String kind = record.getString("type");
+            if (kind.equals("pre")) fields(record, "type", "offset", "length", "language");
+            else fields(record, "type", "offset", "length");
+            TLRPC.MessageEntity entity;
+            switch (kind) {
+                case "bold": entity = new TLRPC.TL_messageEntityBold(); break;
+                case "italic": entity = new TLRPC.TL_messageEntityItalic(); break;
+                case "underline": entity = new TLRPC.TL_messageEntityUnderline(); break;
+                case "strikethrough": entity = new TLRPC.TL_messageEntityStrike(); break;
+                case "spoiler": entity = new TLRPC.TL_messageEntitySpoiler(); break;
+                case "code": entity = new TLRPC.TL_messageEntityCode(); break;
+                case "pre":
+                    entity = new TLRPC.TL_messageEntityPre();
+                    require(!record.has("language") || record.get("language") instanceof String);
+                    entity.language = record.optString("language", "");
+                    break;
+                case "blockquote":
+                case "expandable_blockquote":
+                    entity = new TLRPC.TL_messageEntityBlockquote();
+                    entity.collapsed = kind.equals("expandable_blockquote");
+                    break;
+                default: throw new IllegalArgumentException("GRAMLAB_BRIDGE_INVALID_DATA");
+            }
+            entity.offset = integer(record, "offset");
+            entity.length = integer(record, "length");
+            require(entity.length > 0 && boundary(text, entity.offset)
+                    && (long) entity.offset + entity.length <= text.length()
+                    && boundary(text, entity.offset + entity.length));
+            result.add(entity);
+        }
+        result.sort((left, right) -> left.offset != right.offset
+                ? Integer.compare(left.offset, right.offset) : Integer.compare(right.length, left.length));
+        java.util.ArrayDeque<TLRPC.MessageEntity> active = new java.util.ArrayDeque<>();
+        int quotes = 0;
+        for (TLRPC.MessageEntity entity : result) {
+            while (!active.isEmpty() && active.peekLast().offset + active.peekLast().length <= entity.offset) {
+                if (active.removeLast() instanceof TLRPC.TL_messageEntityBlockquote) quotes--;
+            }
+            if (!active.isEmpty()) {
+                TLRPC.MessageEntity parent = active.peekLast();
+                require(entity.offset + entity.length <= parent.offset + parent.length);
+                require(!(entity instanceof TLRPC.TL_messageEntityCode)
+                        && !(entity instanceof TLRPC.TL_messageEntityPre)
+                        && !(parent instanceof TLRPC.TL_messageEntityCode)
+                        && !(parent instanceof TLRPC.TL_messageEntityPre));
+            }
+            if (entity instanceof TLRPC.TL_messageEntityBlockquote) {
+                require(quotes == 0);
+                quotes++;
+            }
+            active.addLast(entity);
+        }
+        return result;
     }
 
