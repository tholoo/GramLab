diff --git a/TMessagesProj/jni/TgNetWrapper.cpp b/TMessagesProj/jni/TgNetWrapper.cpp
--- a/TMessagesProj/jni/TgNetWrapper.cpp
+++ b/TMessagesProj/jni/TgNetWrapper.cpp
@@ -12,6 +12,40 @@
 #include <openssl/bn.h>
 #include <openssl/pem.h>
 #include <openssl/aes.h>
+
+// Ordinary-file publication must not replace a concurrent original destination.
+// API26 exports syscall; renameat2's libc wrapper itself requires API30.
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <linux/fs.h>
+
+static int gramLabDocumentPath(JNIEnv *env, jbyteArray value, char output[4096]) {
+    if (value == nullptr) return EINVAL;
+    jsize size = env->GetArrayLength(value);
+    if (size <= 0 || size >= 4096) return EINVAL;
+    env->GetByteArrayRegion(value, 0, size, reinterpret_cast<jbyte *>(output));
+    if (env->ExceptionCheck()) return EINVAL;
+    if (memchr(output, 0, static_cast<size_t>(size)) != nullptr) return EINVAL;
+    output[size] = 0;
+    return 0;
+}
+
+extern "C" JNIEXPORT jint JNICALL
+Java_org_telegram_messenger_FileLoader_nativeRenameDocument(
+        JNIEnv *env, jclass, jbyteArray source, jbyteArray destination) {
+    char oldPath[4096], newPath[4096];
+    int invalid = gramLabDocumentPath(env, source, oldPath);
+    if (invalid != 0) return invalid;
+    invalid = gramLabDocumentPath(env, destination, newPath);
+    if (invalid != 0) return invalid;
+    long result = syscall(SYS_renameat2, AT_FDCWD, oldPath, AT_FDCWD,
+                          newPath, RENAME_NOREPLACE);
+    int failure = errno;
+    return result == 0 ? 0 : failure;
+}
 
 JavaVM *java;
 
