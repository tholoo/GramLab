+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import android.app.UiAutomation;
+import android.os.Bundle;
+import android.os.HandlerThread;
+import android.os.Looper;
+import android.os.Process;
+import android.os.SystemClock;
+import android.view.accessibility.AccessibilityNodeInfo;
+import org.json.JSONObject;
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.Arrays;
+
+/** Dedicated-guest shell input through the original application's accessibility actions. */
+public final class GramLabInput {
+    private static final class Rejected extends IllegalArgumentException {
+        final String reason;
+        Rejected(String reason) { this.reason = reason; }
+    }
+
+    private static void require(boolean valid, String reason) {
+        if (!valid) throw new Rejected(reason);
+    }
+
+    private static boolean action(AccessibilityNodeInfo node, int id) {
+        for (AccessibilityNodeInfo.AccessibilityAction candidate : node.getActionList())
+            if (candidate.getId() == id) return true;
+        return false;
+    }
+
+    private static void collect(AccessibilityNodeInfo node, String target, String description,
+            boolean editable, ArrayList<AccessibilityNodeInfo> matches) {
+        if (node == null) return;
+        if (target.contentEquals(node.getPackageName() == null ? "" : node.getPackageName())
+                && node.isVisibleToUser() && node.isEnabled() && !node.isPassword()
+                && (editable ? node.isEditable() && action(node, AccessibilityNodeInfo.ACTION_SET_TEXT)
+                : description.contentEquals(node.getContentDescription() == null ? "" : node.getContentDescription())
+                    && action(node, AccessibilityNodeInfo.ACTION_CLICK))) matches.add(node);
+        for (int index = 0; index < node.getChildCount(); index++) collect(node.getChild(index), target, description, editable, matches);
+    }
+
+    private static AccessibilityNodeInfo unique(UiAutomation automation, String target, String description, boolean editable) {
+        long deadline = SystemClock.elapsedRealtime() + 5000;
+        while (true) {
+            AccessibilityNodeInfo root = automation.getRootInActiveWindow();
+            if (root != null) {
+                require(target.contentEquals(root.getPackageName() == null ? "" : root.getPackageName()), "wrong_window");
+                ArrayList<AccessibilityNodeInfo> matches = new ArrayList<>();
+                collect(root, target, description, editable, matches);
+                require(matches.size() <= 1, editable ? "composer_not_unique" : "send_not_unique");
+                if (matches.size() == 1) return matches.get(0);
+                require(SystemClock.elapsedRealtime() < deadline, editable ? "composer_missing" : "send_missing");
+            } else require(SystemClock.elapsedRealtime() < deadline, "window_unavailable");
+            // Readiness polling never repeats a text or send action. The stock composer
+            // exposes its animated Send control asynchronously after accepting new text.
+            SystemClock.sleep(50);
+        }
+    }
+
+    private static CharSequence text(AccessibilityNodeInfo node) {
+        // The pinned EditTextBoldCursor replaces empty accessibility text with its hint.
+        // Underlying TextView selection/movement metadata still distinguishes an empty
+        // editor from literal text equal to that hint. Never probe by changing selection.
+        boolean empty = node.getTextSelectionStart() == -1 && node.getTextSelectionEnd() == -1
+                && node.getMovementGranularities() == 0
+                && !action(node, AccessibilityNodeInfo.ACTION_SET_SELECTION)
+                && !action(node, AccessibilityNodeInfo.ACTION_NEXT_AT_MOVEMENT_GRANULARITY)
+                && !action(node, AccessibilityNodeInfo.ACTION_PREVIOUS_AT_MOVEMENT_GRANULARITY);
+        return node.isShowingHintText() || node.getText() == null || empty ? "" : node.getText();
+    }
+
+    private static String string(JSONObject input, String key) throws Exception {
+        Object value = input.get(key);
+        require(value instanceof String, "invalid_text");
+        String text = (String) value;
+        require(text.equals(new String(text.getBytes(StandardCharsets.UTF_8), StandardCharsets.UTF_8)), "invalid_unicode");
+        return text;
+    }
+
+    public static void main(String[] arguments) {
