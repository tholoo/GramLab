--- /dev/null
+++ b/TMessagesProj_GramLab/src/main/java/org/telegram/gramlab/ComposerProbe.java
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.tgnet.SerializedData;
+import org.telegram.tgnet.TLRPC;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.Arrays;
+
+/** Pinned TL acknowledgment/difference serialization against a separate synthetic world. */
+public final class ComposerProbe {
+    private static void require(boolean valid) {
+        if (!valid) throw new IllegalStateException("GRAMLAB_COMPOSER_CODEC_FAILED");
+    }
+
+    private static TLRPC.TL_messages_sendMessage command(long peer, long randomId) {
+        TLRPC.TL_messages_sendMessage query = new TLRPC.TL_messages_sendMessage();
+        TLRPC.TL_inputPeerUser target = new TLRPC.TL_inputPeerUser();
+        target.user_id = peer;
+        query.peer = target;
+        query.random_id = randomId;
+        query.message = "hello سلام 👩🏽‍💻";
+        query.clear_draft = true;
+        query.send_as = new TLRPC.TL_inputPeerSelf();
+        query.flags = 1 << 3;
+        TLRPC.TL_messageEntityBold entity = new TLRPC.TL_messageEntityBold();
+        entity.offset = 0; entity.length = 5;
+        query.entities.add(entity);
+        return query;
+    }
+
+    private static byte[] encode(TLRPC.Updates response) {
+        SerializedData data = new SerializedData();
+        response.serializeToStream(data);
+        return data.toByteArray();
+    }
+
+    public static void main(String[] arguments) throws Exception {
+        JSONObject config = new JSONObject(new String(Files.readAllBytes(Paths.get(arguments[0])), StandardCharsets.UTF_8));
+        GramLabBridge.Snapshot initial = GramLabBridge.connect(config);
+        require(initial.messagePosition == 0 && initial.sends.isEmpty());
+        long peer = initial.chatIdsByPeer.keySet().iterator().next();
+        ApplicationLoader.applicationLoaderInstance = new ApplicationLoader() {
+            @Override protected boolean isAndroidTestEnv() { return true; }
+        };
+        TLRPC.TL_messages_sendMessage query = command(peer, -42);
+        GramLabBridge.SendResult first = GramLabBridge.send(config, initial, query);
+        byte[] encoded = encode(first.acknowledgment());
+        require(Arrays.equals(encoded, encode(GramLabBridge.send(config, initial, query).acknowledgment())));
+        SerializedData data = new SerializedData(encoded);
+        TLRPC.Updates ack = TLRPC.Updates.TLdeserialize(data, data.readInt32(true), true);
+        require(ack instanceof TLRPC.TL_updateShortSentMessage && ack.out && ack.id == 1
+                && ack.pts == 1 && ack.pts_count == 1 && ack.entities.size() == 1
+                && ack.entities.get(0).offset == 0 && ack.entities.get(0).length == 5);
+        int rejected = 0;
+        for (int bit : new int[] {0, 2, 5, 6, 10, 14, 15, 16, 17, 18, 19, 21, 22, 23, 24}) {
+            TLRPC.TL_messages_sendMessage invalid = command(peer, 100 + bit);
+            invalid.flags |= 1 << bit;
+            try { GramLabBridge.send(config, initial, invalid); }
+            catch (UnsupportedOperationException expected) { rejected++; }
+        }
+        query.message = "changed payload";
+        try { GramLabBridge.send(config, initial, query); }
+        catch (IllegalArgumentException expected) { rejected++; }
+        TLRPC.TL_messages_sendMessage alternate = command(peer, 200);
+        TLRPC.TL_inputPeerUser sender = new TLRPC.TL_inputPeerUser();
+        sender.user_id = peer;
+        alternate.send_as = sender;
+        try { GramLabBridge.send(config, initial, alternate); }
+        catch (UnsupportedOperationException expected) { rejected++; }
+        require(rejected == 17 && GramLabBridge.connect(config).messagePosition == 1);
+        GramLabBridge.send(config, initial, command(peer, 43));
+        TLRPC.TL_updates_getDifference difference = new TLRPC.TL_updates_getDifference();
+        difference.flags = 1; difference.pts_total_limit = 1; difference.date = initial.now;
+        JSONArray pages = new JSONArray();
+        for (int index = 0; index < 2; index++) {
+            difference.pts = index;
+            TLRPC.updates_Difference page = GramLabBridge.difference(config, initial, difference);
+            SerializedData writer = new SerializedData();
+            page.serializeToStream(writer);
+            SerializedData reader = new SerializedData(writer.toByteArray());
+            page = TLRPC.updates_Difference.TLdeserialize(reader, reader.readInt32(true), true);
+            TLRPC.TL_updates_state state = index == 0 ? page.intermediate_state : page.state;
+            require(page.other_updates.size() == 1 && state.pts == index + 1 && state.seq == index + 1
+                    && state.qts == 0 && state.date == initial.now);
+            pages.put(new JSONObject().put("type", page.getClass().getSimpleName())
+                    .put("pts", state.pts).put("seq", state.seq).put("changes", page.other_updates.size()));
+        }
+        GramLabBridge.Snapshot last = GramLabBridge.connect(config);
+        require(last.messagePosition == 2 && last.sends.size() == 2);
+        System.out.println(new JSONObject().put("rejected", rejected).put("sends", last.sends.size())
+                .put("pages", pages).put("ack", new JSONObject().put("id", ack.id).put("date", ack.date)
+                    .put("pts", ack.pts).put("pts_count", ack.pts_count).put("out", ack.out)
+                    .put("flags", ack.flags).put("entity", ack.entities.get(0).getClass().getSimpleName())));
+    }
+}
