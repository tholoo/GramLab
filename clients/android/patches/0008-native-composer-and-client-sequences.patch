@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.messenger;
+
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.gramlab.GramLabBridge;
+import org.telegram.tgnet.TLRPC;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Scoped replica reconciliation using the stock storage and send-helper completion paths. */
+public final class GramLabSendRecovery {
+    public static final class Correction {
+        final int oldId;
+        final GramLabBridge.SendResult send;
+        Correction(int oldId, GramLabBridge.SendResult send) { this.oldId = oldId; this.send = send; }
+    }
+
+    /** Call on the account storage queue, after authoritative history backfill when restarting. */
+    public static ArrayList<Correction> store(int account, List<GramLabBridge.SendResult> sends) throws Exception {
+        MessagesStorage storage = MessagesStorage.getInstance(account);
+        if (Thread.currentThread() != storage.getStorageQueue()) throw new IllegalStateException("GRAMLAB_STORAGE_THREAD");
+        ArrayList<Correction> corrections = new ArrayList<>();
+        for (GramLabBridge.SendResult send : sends) {
+            if (send.randomId() == 0) continue;
+            SQLiteCursor cursor = storage.getDatabase().queryFinalized(
+                    "SELECT r.mid FROM randoms_v2 r JOIN messages_v2 m ON m.mid=r.mid AND m.uid=r.uid "
+                    + "WHERE r.random_id=? AND r.uid=? AND r.mid<0", send.randomId(), send.peer);
+            Integer oldId = null;
+            try {
+                if (cursor.next()) oldId = cursor.intValue(0);
+                if (cursor.next()) throw new IllegalStateException("GRAMLAB_AMBIGUOUS_SEND_CORRELATION");
+            } finally { cursor.dispose(); }
+            if (oldId == null) continue;
+            long[] mapped = storage.updateMessageStateAndId(send.randomId(), send.peer, oldId,
+                    send.message.id, send.message.date, false, 0, 0);
+            if (mapped == null || mapped[0] != send.peer || mapped[1] != oldId)
+                throw new IllegalStateException("GRAMLAB_SEND_REMAP_FAILED");
+            ArrayList<TLRPC.Message> messages = new ArrayList<>();
+            messages.add(send.message);
+            storage.putMessages(messages, true, false, false, 0, 0, 0);
+            cursor = storage.getDatabase().queryFinalized(
+                    "SELECT mid, send_state FROM messages_v2 WHERE uid=? AND mid IN (?, ?)",
+                    send.peer, oldId, send.message.id);
+            try {
+                if (!cursor.next() || cursor.intValue(0) != send.message.id || cursor.intValue(1) != 0 || cursor.next())
+                    throw new IllegalStateException("GRAMLAB_SEND_REMAP_NOT_STORED");
+            } finally { cursor.dispose(); }
+            corrections.add(new Correction(oldId, send));
+        }
+        return corrections;
+    }
+
+    /** Call on UI only after every storage correction is complete. */
+    public static void complete(int account, List<Correction> corrections) {
+        if (corrections.isEmpty()) return;
+        SendMessagesHelper helper = SendMessagesHelper.getInstance(account);
+        NotificationCenter notifications = NotificationCenter.getInstance(account);
+        for (Correction correction : corrections) {
+            GramLabBridge.SendResult send = correction.send;
+            helper.processSentMessage(correction.oldId);
+            helper.removeFromSendingMessages(correction.oldId, false);
+            notifications.postNotificationName(NotificationCenter.messageReceivedByServer,
+                    correction.oldId, send.message.id, send.message, send.peer, 0L, -1, false);
+            notifications.postNotificationName(NotificationCenter.messageReceivedByServer2,
+                    correction.oldId, send.message.id, send.message, send.peer, 0L, -1, false);
+        }
+    }
+}
