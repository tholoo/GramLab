+            else if (entity instanceof TLRPC.TL_messageEntityUnderline) type = "underline";
+            else if (entity instanceof TLRPC.TL_messageEntityStrike) type = "strikethrough";
+            else if (entity instanceof TLRPC.TL_messageEntitySpoiler) type = "spoiler";
+            else if (entity instanceof TLRPC.TL_messageEntityCode) type = "code";
+            else if (entity instanceof TLRPC.TL_messageEntityPre) type = "pre";
+            else if (entity instanceof TLRPC.TL_messageEntityBlockquote)
+                type = entity.collapsed ? "expandable_blockquote" : "blockquote";
+            else throw new UnsupportedOperationException();
+            JSONObject record = new JSONObject().put("type", type).put("offset", entity.offset).put("length", entity.length);
+            if (type.equals("pre") && entity.language != null && !entity.language.isEmpty())
+                record.put("language", entity.language);
