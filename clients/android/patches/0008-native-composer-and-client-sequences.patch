+            AccessibilityNodeInfo send = unique(automation, target, description, false);
+            // Never retry: a false return or process interruption can still have an uncertain outcome.
+            require(send.performAction(AccessibilityNodeInfo.ACTION_CLICK), "send_action_rejected");
+            System.out.println(new JSONObject().put("ok", true).put("input", "accessibility")
+                    .put("text_verified", true).put("send_actions", 1).put("uid", Process.myUid()));
+            exit = 0;
+        } catch (Exception failure) {
+            // Exception text and request bodies can contain scenario text; retain only bounded metadata.
+            String reason = failure instanceof Rejected ? ((Rejected) failure).reason : failure.getClass().getSimpleName();
+            System.out.println("{\"ok\":false,\"phase\":\"" + phase + "\",\"error\":\"" + reason
+                    + "\",\"target\":" + targetState + "}");
+        } finally {
+            try {
+                if (connected) UiAutomation.class.getMethod("disconnect").invoke(automation);
+            } catch (Exception failure) { exit = 1; }
+            if (callbacks != null) {
+                callbacks.quitSafely();
+                try { callbacks.join(2000); } catch (InterruptedException failure) { Thread.currentThread().interrupt(); exit = 1; }
+                if (callbacks.isAlive()) exit = 1;
+            }
+        }
+        System.exit(exit);
+    }
+}
