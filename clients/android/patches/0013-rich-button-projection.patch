+    private static Object buttonLabel(TL_iv.RichText value) throws Exception {
+        if (value instanceof TL_iv.textPlain) return ((TL_iv.textPlain) value).text;
+        if (value instanceof TL_iv.textConcat && !value.texts.isEmpty()) {
+            JSONArray result = new JSONArray();
+            for (TL_iv.RichText item : value.texts) result.put(buttonLabel(item));
+            return result;
+        }
+        throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_BUTTON_LABEL");
+    }
