+    private static TL_iv.RichText buttonLabel(Object value) throws JSONException {
+        if (value instanceof String) return text(buttonString((String) value));
+        require(value instanceof JSONArray);
+        JSONArray array = (JSONArray) value;
+        require(array.length() > 0);
+        TL_iv.textConcat result = new TL_iv.textConcat();
+        for (int i = 0; i < array.length(); i++) result.texts.add(buttonLabel(array.get(i)));
+        return result;
+    }
