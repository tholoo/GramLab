+    // Button content arrives canonical. Reject dirty leaves rather than silently cleaning
+    // snapshots differently from the world; callback payloads deliberately skip this check.
+    private static String buttonString(String value) {
+        int bytes = 0;
+        boolean previousDirection = false;
+        for (int i = 0; i < value.length();) {
+            int codepoint = value.codePointAt(i);
+            boolean direction = codepoint == 0x200e || codepoint == 0x200f;
+            require(bytes < 34996 && codepoint != '\t'
+                    && !(codepoint >= 0x2028 && codepoint <= 0x202e)
+                    && codepoint != 0x030a && codepoint != 0x0333 && codepoint != 0x033f
+                    && !(previousDirection && direction));
+            bytes += codepoint < 0x80 ? 1 : codepoint < 0x800 ? 2 : codepoint < 0x10000 ? 3 : 4;
+            previousDirection = direction;
+            i += Character.charCount(codepoint);
+        }
+        return value;
+    }
