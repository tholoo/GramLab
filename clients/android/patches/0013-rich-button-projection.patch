+    private static JSONObject richButton(int flags, TL_iv.RichText text,
+            TL_keyboard.InlineButtonType action, TL_keyboard.RichButtonStyle style) throws Exception {
+        if (flags != (style == null ? 0 : 1)) {
+            throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_BUTTON_FLAGS");
+        }
+        JSONObject result = new JSONObject().put("text", buttonLabel(text));
+        if (action instanceof TL_keyboard.TL_inlineButtonTypeCallback) {
+            TL_keyboard.TL_inlineButtonTypeCallback callback = (TL_keyboard.TL_inlineButtonTypeCallback) action;
+            if (callback.flags != 0 || callback.requires_password) {
+                throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_CALLBACK_FLAGS");
+            }
+            String data = new String(callback.data, StandardCharsets.UTF_8);
+            if (!java.util.Arrays.equals(callback.data, data.getBytes(StandardCharsets.UTF_8))) {
+                throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_CALLBACK_ENCODING");
+            }
+            result.put("callback_data", data);
+        } else if (action instanceof TL_keyboard.TL_inlineButtonTypeCopy) {
+            result.put("copy_text", new JSONObject().put("text",
+                    ((TL_keyboard.TL_inlineButtonTypeCopy) action).copy_text));
+        } else if (action instanceof TL_keyboard.TL_inlineButtonTypeDisabled) {
+            result.put("disabled", new JSONObject());
+        } else throw new IllegalStateException("GRAMLAB_PROBE_UNEXPECTED_BUTTON_ACTION");
