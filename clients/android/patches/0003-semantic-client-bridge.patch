+// SPDX-License-Identifier: GPL-2.0-or-later
+package org.telegram.gramlab;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.tgnet.SerializedData;
+import org.telegram.tgnet.TLRPC;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+
+/** Observe actual TL serialization without starting the application or an account. */
+public final class BridgeProbe {
+    public static void main(String[] args) throws Exception {
+        try {
+            observe(args);
+        } catch (IllegalArgumentException | IllegalStateException failure) {
+            System.out.println(new JSONObject().put("error", failure.getMessage()));
+            System.exit(2);
+        }
+    }
+
+    private static void observe(String[] args) throws Exception {
+        JSONObject config = new JSONObject(new String(Files.readAllBytes(Paths.get(args[0])),
+                StandardCharsets.UTF_8));
+        GramLabBridge.Snapshot snapshot = GramLabBridge.connect(config);
+        // Use upstream's AppTests serialization mode: no local attachment-path extension.
+        // Constructing this context does not run onCreate, providers or any account startup.
+        ApplicationLoader.applicationLoaderInstance = new ApplicationLoader() {
+            @Override
+            protected boolean isAndroidTestEnv() {
+                return true;
+            }
+        };
+        SerializedData encoded = new SerializedData();
+        snapshot.dialogs.serializeToStream(encoded);
+        SerializedData stream = new SerializedData(encoded.toByteArray());
+        TLRPC.messages_Dialogs dialogs = TLRPC.messages_Dialogs.TLdeserialize(
+                stream, stream.readInt32(true), true);
+        JSONArray users = new JSONArray();
+        for (TLRPC.User user : dialogs.users) {
+            users.put(new JSONObject().put("id", user.id).put("first_name", user.first_name)
+                    .put("self", user.self).put("bot", user.bot)
+                    .put("username", user.username == null ? JSONObject.NULL : user.username)
+                    .put("language_code", user.lang_code == null ? JSONObject.NULL : user.lang_code)
+                    .put("phone", user.phone == null ? JSONObject.NULL : user.phone));
+        }
+        JSONArray conversations = new JSONArray();
+        for (TLRPC.Dialog dialog : dialogs.dialogs) {
+            conversations.put(new JSONObject().put("peer_id", dialog.peer.user_id)
+                    .put("top_message", dialog.top_message));
+        }
+        JSONArray messages = new JSONArray();
+        for (Long peer : snapshot.histories.keySet()) {
+            encoded = new SerializedData();
+            snapshot.histories.get(peer).serializeToStream(encoded);
+            stream = new SerializedData(encoded.toByteArray());
+            TLRPC.messages_Messages history = TLRPC.messages_Messages.TLdeserialize(
+                    stream, stream.readInt32(true), true);
+            for (TLRPC.Message message : history.messages) {
+                messages.put(new JSONObject().put("id", message.id)
+                        .put("sender_id", message.from_id.user_id)
+                        .put("recipient_id", message.peer_id.user_id).put("out", message.out)
+                        .put("date", message.date).put("text", message.message));
+            }
+        }
+        System.out.println(new JSONObject().put("persona", snapshot.persona)
+                .put("cursor", snapshot.cursor).put("now", snapshot.now).put("users", users)
+                .put("dialogs", conversations).put("messages", messages)
+                .put("dialog_message_count", dialogs.messages.size()));
+    }
+}
